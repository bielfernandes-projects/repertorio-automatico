issToast(toast.id)}\n              className=\"p-1 text-slate-400 hover:text-slate-200 rounded-lg transition-colors\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n};\n"
