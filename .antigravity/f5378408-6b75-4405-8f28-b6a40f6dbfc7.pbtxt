        lines {
          text: "export class StorageEngine {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  static subscribeStorage(callback: RealtimeCallback) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
