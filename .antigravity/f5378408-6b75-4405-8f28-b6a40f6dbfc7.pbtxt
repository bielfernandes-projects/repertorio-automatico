  file_change {
    absolute_path_uri: "file:///src/components/profile/ProfileView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { useAppStore } from \'../../lib/store\';\nimport { StorageEngine } from \'../../lib/storage\';\nimport { Invitation, SupabaseConfig } from \'../../types\';\nimport { testSupabaseConnection, syncLocalDataToSupabase, fetchRemoteDataFromSupabase } from \'../../lib/supabase\';\nimport { User, Mail, Moon, Sun, Download, LogOut, Check, X, ShieldCheck, MailCheck, Database, RefreshCw, Sparkles, CheckCircle2, AlertCircle } from \'lucide-react\';\n\ninterface ProfileViewProps {\n  onLogout: () => void;\n}\n\nexport const ProfileView: React.FC<ProfileViewProps> = ({ onLogout }) => {\n  const { isDarkMode, toggleDarkMode, showToast } = useAppStore();\n  const user = StorageEngine.getUser();\n\n  const [invitations, setInvitations] = useState<Invitation[]>(() =>\n    StorageEngine.getPendingInvitationsForUser(user.email)\n  );\n\n  // Supabase State\n  const [supabaseConfig, setSupabaseConfig] = useState<SupabaseConfig>(() =>\n    StorageEngine.getSupabaseConfig()\n  );\n  const [supabaseUrl, setSupabaseUrl] = useState(supabaseConfig.url || \'\');\n  const [supabaseKey, setSupabaseKey] = useState(supabaseConfig.anonKey || \'\');\n  const [isTestingSupabase, setIsTestingSupabase] = useState(false);\n  const [isSyncing, setIsSyncing] = useState(false);\n  const [supabaseStatus, setSupabaseStatus] = useState<\'idle\' | \'success\' | \'error\'>(\'idle\');\n\n  // PWA install prompt state\n  const [deferredPrompt, setDeferredPrompt] = useState<any>(null);\n  const [isInstallable, setIsInstallable] = useState(false);\n\n  useEffect(() => {\n    const handleBeforeInstall = (e: Event) => {\n      e.preventDefault();\n      setDeferredPrompt(e);\n      setIsInstallable(true);\n    };\n\n    window.addEventListener(\'beforeinstallprompt\', handleBeforeInstall);\n\n    const unsubscribe = StorageEngine.subscribeStorage(() => {\n      setInvitations(StorageEngine.getPendingInvitationsForUser(user.email));\n    });\n\n    return () => {\n      window.removeEventListener(\'beforeinstallprompt\', handleBeforeInstall);\n      unsubscribe();\n    };\n  }, [user.email]);\n\n  const handleInstallClick = async () => {\n    if (!deferredPrompt) {\n      showToast(\'O app j\303\241 est\303\241 instalado ou n\303\243o \303\251 suportado pelo navegador.\', \'info\');\n      return;\n    }\n    deferredPrompt.prompt();\n    const { outcome } = await deferredPrompt.userChoice;\n    if (outcome === \'accepted\') {\n      showToast(\'Repert\303\263rio Autom\303\241tico instalado com sucesso!\', \'success\');\n      setIsInstallable(false);\n    }\n    setDeferredPrompt(null);\n  };\n\n  const handleRespondInv = (inv: Invitation, accept: boolean) => {\n    StorageEngine.respondToInvitation(inv.id, accept);\n    setInvitations(StorageEngine.getPendingInvitationsForUser(user.email));\n    if (accept) {\n      showToast(`Voc\303\252 aceitou o convite para \"${inv.setlistName}\"!`, \'success\');\n    } else {\n      showToast(\'Convite recusado.\', \'info\');\n    }\n  };\n\n  const handleSaveSupabaseConfig = async () => {\n    const config: SupabaseConfig = {\n      url: supabaseUrl.trim(),\n      anonKey: supabaseKey.trim(),\n      enabled: !!(supabaseUrl.trim() && supabaseKey.trim())\n    };\n\n    StorageEngine.setSupabaseConfig(config);\n    setSupabaseConfig(config);\n\n    if (!config.enabled) {\n      showToast(\'Configura\303\247\303\265es do Supabase removidas.\', \'info\');\n      setSupabaseStatus(\'idle\');\n      return;\n    }\n\n    setIsTestingSupabase(true);\n    const test = await testSupabaseConnection();\n    setIsTestingSupabase(false);\n\n    if (test.success) {\n      setSupabaseStatus(\'success\');\n      showToast(\'Conex\303\243o com o Supabase estabelecida com sucesso!\', \'success\');\n    } else {\n      setSupabaseStatus(\'error\');\n      showToast(test.message || \'Falha ao conectar com o Supabase.\', \'error\');\n    }\n  };\n\n  const handleSyncToCloud = async () => {\n    if (!supabaseConfig.enabled) {\n      showToast(\'Configure a URL e a Anon Key do Supabase primeiro.\', \'error\');\n      return;\n    }\n\n    setIsSyncing(true);\n    const result = await syncLocalDataToSupabase();\n    setIsSyncing(false);\n\n    if (result.success) {\n      showToast(\'Dados locais sincronizados com o Supabase!\', \'success\');\n    } else {\n      showToast(result.message || \'Erro durante a sincroniza\303\247\303\243o.\', \'error\');\n    }\n  };\n\n  const handleFetchFromCloud = async () => {\n    if (!supabaseConfig.enabled) {\n      showToast(\'Configure a URL e a Anon Key do Supabase primeiro.\', \'error\');\n      return;\n    }\n\n    setIsSyncing(true);\n    const result = await fetchRemoteDataFromSupabase();\n    setIsSyncing(false);\n\n    if (result.success) {\n      showToast(\'Cat\303\241logo e setlists baixados do Supabase com sucesso!\', \'success\');\n    } else {\n      showToast(result.message || \'Erro ao carregar dados do banco.\', \'error\');\n    }\n  };\n\n  return (\n    <div className=\"p-4 space-y-5 pb-24 animate-in fade-in duration-200\">\n      {/* Profile Card */}\n      <div className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-5 shadow-sm dark:shadow-xl space-y-4\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center text-white font-black text-lg shadow-md shadow-purple-900/30\">\n            {user.name.charAt(0).toUpperCase()}\n          </div>\n          <div>\n            <h2 className=\"text-base font-bold text-zinc-900 dark:text-zinc-100\">{user.name}</h2>\n            <p className=\"text-xs text-zinc-500 dark:text-purple-300/80 flex items-center gap-1\">\n              <Mail className=\"w-3 h-3 text-purple-500\" />\n              {user.email}\n            </p>\n          </div>\n        </div>\n\n        <div className=\"pt-3 border-t border-zinc-100 dark:border-purple-900/30 flex items-center justify-between text-xs text-zinc-600 dark:text-purple-200\">\n          <span className=\"flex items-center gap-1.5 font-medium\">\n            <ShieldCheck className=\"w-4 h-4 text-purple-600 dark:text-purple-400\" />\n            Sess\303\243o ativa e protegida\n          </span>\n          <span className=\"text-[10px] text-zinc-400 dark:text-zinc-500 font-mono\">v1.2.0 PWA</span>\n        </div>\n      </div>\n\n      {/* Supabase Database Integration Card */}\n      <div className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-5 shadow-sm dark:shadow-xl space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-2 bg-purple-600/10 dark:bg-purple-950/60 border border-purple-500/20 rounded-xl text-purple-600 dark:text-purple-400\">\n              <Database className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-xs font-bold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider\">\n                Banco de Dados Supabase\n              </h3>\n              <p className=\"text-[11px] text-zinc-500 dark:text-purple-300/70\">\n                Sincronize seu cat\303\241logo e setlists na nuvem\n              </p>\n            </div>\n          </div>\n\n          {supabaseConfig.enabled && (\n            <span className=\"text-[10px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/60 px-2.5 py-0.5 rounded-full flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3 h-3\" />\n              Ativo\n            </span>\n          )}\n        </div>\n\n        <div className=\"space-y-3 pt-1\">\n          <div>\n            <label className=\"block text-[11px] font-bold text-zinc-700 dark:text-purple-200 mb-1\">\n              Supabase Project URL\n            </label>\n            <input\n              type=\"text\"\n              value={supabaseUrl}\n              onChange={(e) => setSupabaseUrl(e.target.value)}\n              placeholder=\"https://xyzcompany.supabase.co\"\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3 py-2 text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-purple-600 font-mono\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-[11px] font-bold text-zinc-700 dark:text-purple-200 mb-1\">\n              Supabase Anon API Key\n            </label>\n            <input\n              type=\"password\"\n              value={supabaseKey}\n              onChange={(e) => setSupabaseKey(e.target.value)}\n              placeholder=\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3 py-2 text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-purple-600 font-mono\"\n            />\n          </div>\n\n          <div className=\"flex items-center gap-2 pt-1\">\n            <button\n              onClick={handleSaveSupabaseConfig}\n              disabled={isTestingSupabase}\n              className=\"flex-1 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs py-2.5 rounded-xl transition-colors shadow-md flex items-center justify-center gap-1.5\"\n            >\n              {isTestingSupabase ? (\n                <>\n                  <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Testando...</span>\n                </>\n              ) : (\n                <span>Testar e Salvar Credenciais</span>\n              )}\n            </button>\n          </div>\n\n          {/* Cloud Sync controls */}\n          {supabaseConfig.enabled && (\n            <div className=\"pt-3 border-t border-zinc-100 dark:border-purple-900/30 grid grid-cols-2 gap-2\">\n              <button\n                onClick={handleSyncToCloud}\n                disabled={isSyncing}\n                className=\"bg-zinc-100 dark:bg-purple-950/40 hover:bg-zinc-200 dark:hover:bg-purple-900/60 border border-zinc-300 dark:border-purple-800/40 text-zinc-800 dark:text-purple-200 font-bold text-[11px] py-2 rounded-xl transition-colors flex items-center justify-center gap-1.5\"\n              >\n                <RefreshCw className={`w-3.5 h-3.5 text-purple-600 dark:text-purple-400 ${isSyncing ? \'animate-spin\' : \'\'}`} />\n                <span>Enviar para Nuvem</span>\n              </button>\n\n              <button\n                onClick={handleFetchFromCloud}\n                disabled={isSyncing}\n                className=\"bg-zinc-100 dark:bg-purple-950/40 hover:bg-zinc-200 dark:hover:bg-purple-900/60 border border-zinc-300 dark:border-purple-800/40 text-zinc-800 dark:text-purple-200 font-bold text-[11px] py-2 rounded-xl transition-colors flex items-center justify-center gap-1.5\"\n              >\n                <Download className={`w-3.5 h-3.5 text-purple-600 dark:text-purple-400 ${isSyncing ? \'animate-spin\' : \'\'}`} />\n                <span>Baixar da Nuvem</span>\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Pending Invitations Section */}\n      <div className=\"space-y-2.5\">\n        <h3 className=\"text-xs font-bold text-zinc-500 dark:text-purple-300 uppercase tracking-wider flex items-center gap-1.5\">\n          <MailCheck className=\"w-3.5 h-3.5 text-purple-600 dark:text-purple-400\" />\n          Convites Recebidos ({invitations.length})\n        </h3>\n\n        {invitations.length === 0 ? (\n          <div className=\"bg-white/50 dark:bg-[#120c24]/50 border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 text-center\">\n            <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">Nenhum convite pendente para a sua conta.</p>\n          </div>\n        ) : (\n          <div className=\"space-y-2\">\n            {invitations.map((inv) => (\n              <div\n                key={inv.id}\n                className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 space-y-2.5 shadow-sm\"\n              >\n                <div>\n                  <h4 className=\"text-sm font-bold text-zinc-900 dark:text-zinc-100\">\n                    <span className=\"text-purple-600 dark:text-purple-400\">{inv.ownerEmail}</span> te convidou para o setlist:\n                  </h4>\n                  <p className=\"text-xs font-semibold text-zinc-800 dark:text-zinc-200 mt-0.5\">\"{inv.setlistName}\"</p>\n                  <span className=\"text-[10px] text-zinc-500 dark:text-zinc-400 block mt-1\">\n                    Permiss\303\243o: {inv.role === \'edit\' ? \'Pode Editar\' : \'Somente Leitura\'}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-zinc-100 dark:border-purple-900/30\">\n                  <button\n                    onClick={() => handleRespondInv(inv, false)}\n                    className=\"flex items-center gap-1 px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 text-zinc-700 dark:text-zinc-300 font-semibold text-xs rounded-xl transition-colors\"\n                  >\n                    <X className=\"w-3.5 h-3.5\" />\n                    Recusar\n                  </button>\n                  <button\n                    onClick={() => handleRespondInv(inv, true)}\n                    className=\"flex items-center gap-1 px-4 py-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs rounded-xl shadow-md transition-colors\"\n                  >\n                    <Check className=\"w-3.5 h-3.5\" />\n                    Aceitar Setlist\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Preferences & PWA Options */}\n      <div className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 space-y-3 shadow-sm\">\n        <h3 className=\"text-xs font-bold text-zinc-500 dark:text-purple-300 uppercase tracking-wider\">\n          Prefer\303\252ncias do App\n        </h3>\n\n        {/* Dark Mode Toggle */}\n        <div className=\"flex items-center justify-between py-1\">\n          <div className=\"flex items-center gap-2.5 text-xs text-zinc-800 dark:text-zinc-200\">\n            {isDarkMode ? <Moon className=\"w-4 h-4 text-purple-400\" /> : <Sun className=\"w-4 h-4 text-amber-500\" />}\n            <span className=\"font-semibold\">Tema Visual (Modo Escuro / Claro)</span>\n          </div>\n\n          <button\n            onClick={toggleDarkMode}\n            className=\"bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-800/60 px-3 py-1.5 rounded-xl text-xs font-bold text-zinc-800 dark:text-zinc-100 hover:border-purple-600 transition-colors\"\n          >\n            {isDarkMode ? \'Escuro (Preto/Roxo)\' : \'Claro\'}\n          </button>\n        </div>\n\n        {/* PWA Install */}\n        <div className=\"flex items-center justify-between py-1 border-t border-zinc-100 dark:border-purple-900/30 pt-3\">\n          <div className=\"flex items-center gap-2.5 text-xs text-zinc-800 dark:text-zinc-200\">\n            <Download className=\"w-4 h-4 text-purple-600 dark:text-purple-400\" />\n            <div>\n              <span className=\"font-semibold block\">Instalar PWA no Celular</span>\n              <span className=\"text-[10px] text-zinc-400 dark:text-zinc-500\">Adicione \303\240 Tela de In\303\255cio</span>\n            </div>\n          </div>\n\n          <button\n            onClick={handleInstallClick}\n            className=\"bg-purple-50 dark:bg-purple-950/40 hover:bg-purple-100 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40 px-3 py-1.5 rounded-xl text-xs font-bold transition-colors\"\n          >\n            Instalar\n          </button>\n        </div>\n      </div>\n\n      {/* Logout Action */}\n      <button\n        onClick={onLogout}\n        className=\"w-full bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-800/50 text-rose-600 dark:text-rose-300 font-bold text-xs py-3 rounded-2xl flex items-center justify-center gap-2 transition-colors active:scale-95 shadow-sm\"\n      >\n        <LogOut className=\"w-4 h-4\" />\n        <span>Sair da Conta (Logout)</span>\n      </button>\n    </div>\n  );\n};\n"
