        }
        lines {
          text: "  if (!clean) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const isMinor = clean.includes(\'m\') || clean.includes(\'menor\');"
