          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  static setUser(user: UserProfile) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
