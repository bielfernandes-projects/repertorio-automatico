          text: "    try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const items: CatalogSong[] = JSON.parse(raw);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Sort alphabetically by name"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
