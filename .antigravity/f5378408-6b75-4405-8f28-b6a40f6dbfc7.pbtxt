    instruction: "Add Create Invitation modal and sent invitations section to ProfileView.tsx"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect } from \'react\';\nimport { useAppStore } from \'../../lib/store\';\nimport { StorageEngine } from \'../../lib/storage\';\nimport { Invitation } from \'../../types\';\nimport { Mail, Moon, Sun, Download, LogOut, Check, X, ShieldCheck, MailCheck } from \'lucide-react\';\n\ninterface ProfileViewProps {\n  onLogout: () => void;\n}\n\nexport const ProfileView: React.FC<ProfileViewProps> = ({ onLogout }) => {\n  const { isDarkMode, toggleDarkMode, showToast } = useAppStore();\n  const user = StorageEngine.getUser();\n\n  const [invitations, setInvitations] = useState<Invitation[]>(() =>\n    StorageEngine.getPendingInvitationsForUser(user.email)\n  );\n\n  // PWA install prompt state\n  const [deferredPrompt, setDeferredPrompt] = useState<any>(null);\n\n  useEffect(() => {\n    const handleBeforeInstall = (e: Event) => {\n      e.preventDefault();\n      setDeferredPrompt(e);\n    };\n\n    window.addEventListener(\'beforeinstallprompt\', handleBeforeInstall);\n\n    const unsubscribe = StorageEngine.subscribeStorage(() => {\n      setInvitations(StorageEngine.getPendingInvitationsForUser(user.email));\n    });\n\n    return () => {\n      window.removeEventListener(\'beforeinstallprompt\', handleBeforeInstall);\n      unsubscribe();\n    };\n  }, [user.email]);\n\n  const handleInstallClick = async () => {\n    if (!deferredPrompt) {\n      showToast(\'O app j\303\241 est\303\241 instalado ou n\303\243o \303\251 suportado pelo navegador.\', \'info\');\n      return;\n    }\n    deferredPrompt.prompt();\n    const { outcome } = await deferredPrompt.userChoice;\n    if (outcome === \'accepted\') {\n      showToast(\'Repert\303\263rio Autom\303\241tico instalado com sucesso!\', \'success\');\n    }\n    setDeferredPrompt(null);\n  };\n\n  const handleRespondInv = (inv: Invitation, accept: boolean) => {\n    StorageEngine.respondToInvitation(inv.id, accept);\n    setInvitations(StorageEngine.getPendingInvitationsForUser(user.email));\n    if (accept) {\n      showToast(`Voc\303\252 aceitou o convite para \"${inv.setlistName}\"!`, \'success\');\n    } else {\n      showToast(\'Convite recusado.\', \'info\');\n    }\n  };"
        replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { useAppStore } from \'../../lib/store\';\nimport { StorageEngine } from \'../../lib/storage\';\nimport { syncLocalDataToSupabase } from \'../../lib/supabase\';\nimport { Invitation, Setlist } from \'../../types\';\nimport { Modal } from \'../common/Modal\';\nimport { Mail, Moon, Sun, Download, LogOut, Check, X, ShieldCheck, MailCheck, UserPlus, Send, Trash2 } from \'lucide-react\';\n\ninterface ProfileViewProps {\n  onLogout: () => void;\n}\n\nexport const ProfileView: React.FC<ProfileViewProps> = ({ onLogout }) => {\n  const { isDarkMode, toggleDarkMode, showToast } = useAppStore();\n  const user = StorageEngine.getUser();\n\n  const [invitations, setInvitations] = useState<Invitation[]>(() =>\n    StorageEngine.getPendingInvitationsForUser(user.email)\n  );\n\n  const [sentInvitations, setSentInvitations] = useState<Invitation[]>(() =>\n    StorageEngine.getSentInvitationsFromUser(user.email)\n  );\n\n  const [userSetlists, setUserSetlists] = useState<Setlist[]>(() =>\n    StorageEngine.getSetlistsForUser(user.email).filter((s) => s.ownerEmail === user.email)\n  );\n\n  // Modal Create Invite state\n  const [isCreateInviteOpen, setIsCreateInviteOpen] = useState(false);\n  const [selectedSetlistId, setSelectedSetlistId] = useState(\'\');\n  const [inviteEmail, setInviteEmail] = useState(\'\');\n  const [inviteRole, setInviteRole] = useState<\'edit\' | \'view\'>(\'edit\');\n  const [isSubmittingInvite, setIsSubmittingInvite] = useState(false);\n\n  // PWA install prompt state\n  const [deferredPrompt, setDeferredPrompt] = useState<any>(null);\n\n  const reloadData = () => {\n    setInvitations(StorageEngine.getPendingInvitationsForUser(user.email));\n    setSentInvitations(StorageEngine.getSentInvitationsFromUser(user.email));\n    setUserSetlists(\n      StorageEngine.getSetlistsForUser(user.email).filter((s) => s.ownerEmail === user.email)\n    );\n  };\n\n  useEffect(() => {\n    const handleBeforeInstall = (e: Event) => {\n      e.preventDefault();\n      setDeferredPrompt(e);\n    };\n\n    window.addEventListener(\'beforeinstallprompt\', handleBeforeInstall);\n\n    const unsubscribe = StorageEngine.subscribeStorage(() => {\n      reloadData();\n    });\n\n    return () => {\n      window.removeEventListener(\'beforeinstallprompt\', handleBeforeInstall);\n      unsubscribe();\n    };\n  }, [user.email]);\n\n  const handleInstallClick = async () => {\n    if (!deferredPrompt) {\n      showToast(\'O app j\303\241 est\303\241 instalado ou n\303\243o \303\251 suportado pelo navegador.\', \'info\');\n      return;\n    }\n    deferredPrompt.prompt();\n    const { outcome } = await deferredPrompt.userChoice;\n    if (outcome === \'accepted\') {\n      showToast(\'Repert\303\263rio Autom\303\241tico instalado com sucesso!\', \'success\');\n    }\n    setDeferredPrompt(null);\n  };\n\n  const handleRespondInv = async (inv: Invitation, accept: boolean) => {\n    StorageEngine.respondToInvitation(inv.id, accept);\n    reloadData();\n    if (accept) {\n      showToast(`Voc\303\252 aceitou o convite para \"${inv.setlistName}\"!`, \'success\');\n    } else {\n      showToast(\'Convite recusado.\', \'info\');\n    }\n\n    // Sync with Supabase if configured\n    if (StorageEngine.getSupabaseConfig().isConnected) {\n      await syncLocalDataToSupabase();\n    }\n  };\n\n  const handleOpenCreateInvite = () => {\n    const owned = StorageEngine.getSetlistsForUser(user.email).filter(\n      (s) => s.ownerEmail === user.email\n    );\n    if (owned.length === 0) {\n      showToast(\'Voc\303\252 precisa criar um setlist antes de poder enviar convites.\', \'info\');\n      return;\n    }\n    setSelectedSetlistId(owned[0].id);\n    setInviteEmail(\'\');\n    setInviteRole(\'edit\');\n    setIsCreateInviteOpen(true);\n  };\n\n  const handleSendInviteSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!inviteEmail.trim()) {\n      showToast(\'Informe o e-mail do m\303\272sico a ser convidado.\', \'error\');\n      return;\n    }\n    if (!selectedSetlistId) {\n      showToast(\'Selecione um setlist para compartilhar.\', \'error\');\n      return;\n    }\n\n    setIsSubmittingInvite(true);\n    const success = StorageEngine.sendInvitation(selectedSetlistId, inviteEmail.trim(), inviteRole);\n\n    if (success) {\n      showToast(`Convite enviado para \"${inviteEmail.trim()}\"!`, \'success\');\n      setIsCreateInviteOpen(false);\n      setInviteEmail(\'\');\n\n      // Push to Supabase if connected\n      if (StorageEngine.getSupabaseConfig().isConnected) {\n        await syncLocalDataToSupabase();\n      }\n      reloadData();\n    } else {\n      showToast(\'N\303\243o foi poss\303\255vel enviar o convite (e-mail igual ao seu ou setlist inv\303\241lido).\', \'error\');\n    }\n    setIsSubmittingInvite(false);\n  };\n\n  const handleRevokeInvite = async (inv: Invitation) => {\n    StorageEngine.revokeInvitation(inv.setlistId, inv.invitedEmail);\n    reloadData();\n    showToast(`Convite para \"${inv.invitedEmail}\" foi cancelado.`, \'info\');\n\n    if (StorageEngine.getSupabaseConfig().isConnected) {\n      await syncLocalDataToSupabase();\n    }\n  };"
      }
      num_matches: 1
    }
  }
}
