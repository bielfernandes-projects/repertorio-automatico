  file_change {
    absolute_path_uri: "file:///src/components/setlists/SetlistsList.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useAppStore } from \'../../lib/store\';\nimport { StorageEngine } from \'../../lib/storage\';\nimport { Setlist } from \'../../types\';\nimport { Modal } from \'../common/Modal\';\nimport { Plus, ListMusic, Copy, Trash2, ChevronRight, Users, Sparkles } from \'lucide-react\';\n\nexport const SetlistsList: React.FC = () => {\n  const { setActiveSetlistId, showToast, showCascadeWarning } = useAppStore();\n  const currentUser = StorageEngine.getUser();\n  const [setlists, setSetlists] = useState<Setlist[]>(() =>\n    StorageEngine.getSetlistsForUser(currentUser.email)\n  );\n\n  // Modal states\n  const [isCreateOpen, setIsCreateOpen] = useState(false);\n  const [newSetName, setNewSetName] = useState(\'\');\n\n  const [duplicateTarget, setDuplicateTarget] = useState<Setlist | null>(null);\n  const [duplicateName, setDuplicateName] = useState(\'\');\n\n  const reloadSetlists = () => {\n    setSetlists(StorageEngine.getSetlistsForUser(currentUser.email));\n  };\n\n  const handleCreate = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newSetName.trim()) return;\n\n    const created = StorageEngine.createSetlist(newSetName);\n    setIsCreateOpen(false);\n    setNewSetName(\'\');\n    reloadSetlists();\n    showToast(`Setlist \"${created.name}\" criado!`, \'success\');\n    setActiveSetlistId(created.id);\n  };\n\n  const handleDuplicate = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!duplicateTarget || !duplicateName.trim()) return;\n\n    const copy = StorageEngine.duplicateSetlist(duplicateTarget.id, duplicateName);\n    setDuplicateTarget(null);\n    setDuplicateName(\'\');\n    reloadSetlists();\n    if (copy) {\n      showToast(`Setlist duplicado como \"${copy.name}\"!`, \'success\');\n    }\n  };\n\n  const handleDeleteRequest = (setlist: Setlist, e: React.MouseEvent) => {\n    e.stopPropagation();\n    showCascadeWarning({\n      setlistId: setlist.id,\n      affectedBlocksCount: setlist.blocks.length,\n      affectedSetlistsCount: 1,\n      title: `Excluir Setlist \"${setlist.name}\"?`,\n      description: \'Esta a\303\247\303\243o excluir\303\241 o setlist e todos os seus blocos e refer\303\252ncias de m\303\272sicas. O acervo do cat\303\241logo n\303\243o ser\303\241 alterado.\',\n      onConfirm: () => {\n        StorageEngine.deleteSetlist(setlist.id);\n        reloadSetlists();\n        showToast(`Setlist \"${setlist.name}\" exclu\303\255do.`, \'info\');\n      }\n    });\n  };\n\n  return (\n    <div className=\"p-4 space-y-4 pb-24 animate-in fade-in duration-200\">\n      {/* Header bar action */}\n      <div className=\"flex items-center justify-between\">\n        <h2 className=\"text-sm font-bold text-slate-300 uppercase tracking-wider\">\n          Seus Setlists ({setlists.length})\n        </h2>\n\n        <button\n          id=\"create-setlist-cta-btn\"\n          onClick={() => setIsCreateOpen(true)}\n          className=\"flex items-center gap-1.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs px-3.5 py-2 rounded-xl shadow-lg shadow-emerald-500/20 active:scale-95 transition-transform\"\n        >\n          <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n          <span>Novo Setlist</span>\n        </button>\n      </div>\n\n      {/* Empty State Onboarding */}\n      {setlists.length === 0 ? (\n        <div className=\"bg-slate-900/60 border border-slate-800 rounded-2xl p-8 text-center my-6 space-y-4\">\n          <div className=\"w-16 h-16 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center justify-center mx-auto text-emerald-400\">\n            <ListMusic className=\"w-8 h-8\" />\n          </div>\n          <div>\n            <h3 className=\"text-base font-bold text-slate-100 mb-1\">Voc\303\252 ainda n\303\243o tem setlists</h3>\n            <p className=\"text-xs text-slate-400 max-w-xs mx-auto\">\n              Crie seu primeiro setlist para organizar os blocos e os tons de cada m\303\272sica do seu show.\n            </p>\n          </div>\n          <button\n            onClick={() => setIsCreateOpen(true)}\n            className=\"bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-500/20 inline-flex items-center gap-2 active:scale-95 transition-transform\"\n          >\n            <Sparkles className=\"w-4 h-4\" />\n            <span>Criar meu primeiro setlist</span>\n          </button>\n        </div>\n      ) : (\n        /* Setlists Card List */\n        <div className=\"space-y-2.5\">\n          {setlists.map((setlist) => {\n            const isOwner = setlist.ownerEmail === currentUser.email;\n            const totalSongs = setlist.blocks.reduce((acc, b) => acc + b.items.length, 0);\n\n            return (\n              <div\n                key={setlist.id}\n                onClick={() => setActiveSetlistId(setlist.id)}\n                className=\"group bg-slate-900/80 hover:bg-slate-800/90 border border-slate-800 hover:border-slate-700/80 rounded-2xl p-4 transition-all duration-200 cursor-pointer shadow-md active:scale-[0.99] flex items-center justify-between gap-3\"\n              >\n                <div className=\"min-w-0 flex-1\">\n                  <div className=\"flex items-center gap-2 mb-1\">\n                    <h3 className=\"text-sm font-bold text-slate-100 group-hover:text-emerald-400 transition-colors truncate\">\n                      {setlist.name}\n                    </h3>\n                    {!isOwner && (\n                      <span className=\"text-[10px] font-semibold bg-sky-950/80 text-sky-400 border border-sky-800/60 px-2 py-0.5 rounded-full flex items-center gap-1 shrink-0\">\n                        <Users className=\"w-3 h-3\" />\n                        Compartilhado\n                      </span>\n                    )}\n                  </div>\n\n                  <div className=\"flex items-center gap-3 text-[11px] text-slate-400\">\n                    <span>\n                      <strong className=\"text-slate-200 font-semibold\">{setlist.blocks.length}</strong>{\' \'}\n                      {setlist.blocks.length === 1 ? \'bloco\' : \'blocos\'}\n                    </span>\n                    <span>\342\200\242</span>\n                    <span>\n                      <strong className=\"text-slate-200 font-semibold\">{totalSongs}</strong>{\' \'}\n                      {totalSongs === 1 ? \'m\303\272sica\' : \'m\303\272sicas\'}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-1 shrink-0\" onClick={(e) => e.stopPropagation()}>\n                  <button\n                    onClick={() => {\n                      setDuplicateTarget(setlist);\n                      setDuplicateName(`${setlist.name} (C\303\263pia)`);\n                    }}\n                    className=\"p-2 text-slate-400 hover:text-emerald-400 hover:bg-slate-800 rounded-xl transition-colors\"\n                    title=\"Duplicar Setlist\"\n                  >\n                    <Copy className=\"w-4 h-4\" />\n                  </button>\n\n                  {isOwner && (\n                    <button\n                      onClick={(e) => handleDeleteRequest(setlist, e)}\n                      className=\"p-2 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-xl transition-colors\"\n                      title=\"Excluir Setlist\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  )}\n\n                  <ChevronRight className=\"w-5 h-5 text-slate-600 group-hover:text-emerald-400 transition-colors ml-1\" />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Modal Create Setlist */}\n      <Modal isOpen={isCreateOpen} onClose={() => setIsCreateOpen(false)} title=\"Criar Novo Setlist\">\n        <form onSubmit={handleCreate} className=\"space-y-4\">\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1.5\">\n              Nome do Setlist *\n            </label>\n            <input\n              type=\"text\"\n              required\n              autoFocus\n              value={newSetName}\n              onChange={(e) => setNewSetName(e.target.value)}\n              placeholder=\"ex: Casamento Julho / Barzinho Sexta\"\n              className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-end gap-2 pt-2\">\n            <button\n              type=\"button\"\n              onClick={() => setIsCreateOpen(false)}\n              className=\"px-4 py-2 text-xs font-semibold text-slate-400 hover:text-slate-200\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-500/20\"\n            >\n              Criar Setlist\n            </button>\n          </div>\n        </form>\n      </Modal>\n\n      {/* Modal Duplicate Setlist */}\n      <Modal\n        isOpen={!!duplicateTarget}\n        onClose={() => setDuplicateTarget(null)}\n        title=\"Duplicar Setlist\"\n      >\n        <form onSubmit={handleDuplicate} className=\"space-y-4\">\n          <p className=\"text-xs text-slate-400\">\n            Crie uma c\303\263pia independente com todos os blocos e refer\303\252ncias de m\303\272sica.\n          </p>\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1.5\">\n              Nome da C\303\263pia *\n            </label>\n            <input\n              type=\"text\"\n              required\n              value={duplicateName}\n              onChange={(e) => setDuplicateName(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-100 focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-end gap-2 pt-2\">\n            <button\n              type=\"button\"\n              onClick={() => setDuplicateTarget(null)}\n              className=\"px-4 py-2 text-xs font-semibold text-slate-400 hover:text-slate-200\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-500/20\"\n            >\n              Duplicar\n            </button>\n          </div>\n        </form>\n      </Modal>\n    </div>\n  );\n};\n"
