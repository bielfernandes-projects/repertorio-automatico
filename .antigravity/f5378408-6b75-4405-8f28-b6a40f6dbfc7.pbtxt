  file_change {
    absolute_path_uri: "file:///src/components/common/BottomNav.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useAppStore } from \'../../lib/store\';\nimport { ListMusic, Music, User } from \'lucide-react\';\n\nexport const BottomNav: React.FC = () => {\n  const {\n    activeTab,\n    setActiveTab,\n    focusedBlockId,\n    setActiveSetlistId\n  } = useAppStore();\n\n  // Hide bottom nav in focused block view (immersive mode)\n  if (focusedBlockId) return null;\n\n  const handleTabClick = (tab: \'setlists\' | \'catalog\' | \'profile\') => {\n    // If clicking setlists tab while inside a setlist detail, exit back to list\n    if (tab === \'setlists\') {\n      setActiveSetlistId(null);\n    }\n    setActiveTab(tab);\n  };\n\n  return (\n    <nav\n      id=\"bottom-navigation-bar\"\n      className=\"fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-[#090714]/95 backdrop-blur-lg border-t border-zinc-200 dark:border-purple-900/40 max-w-md mx-auto shadow-2xl\"\n    >\n      <div className=\"flex items-center justify-around h-16 px-4\">\n        <button\n          id=\"nav-tab-setlists\"\n          onClick={() => handleTabClick(\'setlists\')}\n          aria-label=\"Setlists\"\n          className={`relative p-3 rounded-2xl transition-all duration-200 active:scale-90 ${\n            activeTab === \'setlists\'\n              ? \'text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/60 shadow-inner\'\n              : \'text-zinc-400 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800/50\'\n          }`}\n        >\n          <ListMusic className=\"w-6 h-6 stroke-[2]\" />\n          {activeTab === \'setlists\' && (\n            <span className=\"absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-purple-600 dark:bg-purple-400 rounded-full\" />\n          )}\n        </button>\n\n        <button\n          id=\"nav-tab-catalog\"\n          onClick={() => handleTabClick(\'catalog\')}\n          aria-label=\"Cat\303\241logo\"\n          className={`relative p-3 rounded-2xl transition-all duration-200 active:scale-90 ${\n            activeTab === \'catalog\'\n              ? \'text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/60 shadow-inner\'\n              : \'text-zinc-400 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800/50\'\n          }`}\n        >\n          <Music className=\"w-6 h-6 stroke-[2]\" />\n          {activeTab === \'catalog\' && (\n            <span className=\"absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-purple-600 dark:bg-purple-400 rounded-full\" />\n          )}\n        </button>\n\n        <button\n          id=\"nav-tab-profile\"\n          onClick={() => handleTabClick(\'profile\')}\n          aria-label=\"Perfil\"\n          className={`relative p-3 rounded-2xl transition-all duration-200 active:scale-90 ${\n            activeTab === \'profile\'\n              ? \'text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/60 shadow-inner\'\n              : \'text-zinc-400 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800/50\'\n          }`}\n        >\n          <User className=\"w-6 h-6 stroke-[2]\" />\n          {activeTab === \'profile\' && (\n            <span className=\"absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-purple-600 dark:bg-purple-400 rounded-full\" />\n          )}\n        </button>\n      </div>\n    </nav>\n  );\n};\n"
