    replacement_chunks {
      target_content: "      {/* Pending Invitations Section */}\n      <div className=\"space-y-2.5\">\n        <h3 className=\"text-xs font-bold text-zinc-500 dark:text-purple-300 uppercase tracking-wider flex items-center gap-1.5\">\n          <MailCheck className=\"w-3.5 h-3.5 text-purple-600 dark:text-purple-400\" />\n          Convites Recebidos ({invitations.length})\n        </h3>\n\n        {invitations.length === 0 ? (\n          <div className=\"bg-white/50 dark:bg-[#120c24]/50 border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 text-center\">\n            <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">Nenhum convite pendente para a sua conta.</p>\n          </div>\n        ) : (\n          <div className=\"space-y-2\">\n            {invitations.map((inv) => (\n              <div\n                key={inv.id}\n                className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 space-y-2.5 shadow-sm\"\n              >\n                <div>\n                  <h4 className=\"text-sm font-bold text-zinc-900 dark:text-zinc-100\">\n                    <span className=\"text-purple-600 dark:text-purple-400\">{inv.ownerEmail}</span> te convidou para o setlist:\n                  </h4>\n                  <p className=\"text-xs font-semibold text-zinc-800 dark:text-zinc-200 mt-0.5\">\"{inv.setlistName}\"</p>\n                  <span className=\"text-[10px] text-zinc-500 dark:text-zinc-400 block mt-1\">\n                    Permiss\303\243o: {inv.role === \'edit\' ? \'Pode Editar\' : \'Somente Leitura\'}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-zinc-100 dark:border-purple-900/30\">\n                  <button\n                    onClick={() => handleRespondInv(inv, false)}\n                    className=\"flex items-center gap-1 px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 text-zinc-700 dark:text-zinc-300 font-semibold text-xs rounded-xl transition-colors\"\n                  >\n                    <X className=\"w-3.5 h-3.5\" />\n                    Recusar\n                  </button>\n                  <button\n                    onClick={() => handleRespondInv(inv, true)}\n                    className=\"flex items-center gap-1 px-4 py-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs rounded-xl shadow-md transition-colors\"\n                  >\n                    <Check className=\"w-3.5 h-3.5\" />\n                    Aceitar Setlist\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>"
      replacement_content: "      {/* Invitations Section */}\n      <div className=\"space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-xs font-bold text-zinc-500 dark:text-purple-300 uppercase tracking-wider flex items-center gap-1.5\">\n            <MailCheck className=\"w-3.5 h-3.5 text-purple-600 dark:text-purple-400\" />\n            Gest\303\243o de Convites\n          </h3>\n\n          <button\n            onClick={handleOpenCreateInvite}\n            className=\"flex items-center gap-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-3.5 py-1.5 rounded-xl shadow-md active:scale-95 transition-transform\"\n          >\n            <UserPlus className=\"w-3.5 h-3.5\" />\n            <span>Criar Convite</span>\n          </button>\n        </div>\n\n        {/* Pending Invitations Received */}\n        <div className=\"space-y-2\">\n          <h4 className=\"text-[11px] font-bold text-zinc-700 dark:text-purple-200\">\n            Convites Recebidos ({invitations.length})\n          </h4>\n\n          {invitations.length === 0 ? (\n            <div className=\"bg-white/50 dark:bg-[#120c24]/50 border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 text-center\">\n              <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">Nenhum convite pendente recebido.</p>\n            </div>\n          ) : (\n            <div className=\"space-y-2\">\n              {invitations.map((inv) => (\n                <div\n                  key={inv.id}\n                  className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 space-y-2.5 shadow-sm\"\n                >\n                  <div>\n                    <h4 className=\"text-sm font-bold text-zinc-900 dark:text-zinc-100\">\n                      <span className=\"text-purple-600 dark:text-purple-400\">{inv.ownerEmail}</span> te convidou para o setlist:\n                    </h4>\n                    <p className=\"text-xs font-semibold text-zinc-800 dark:text-zinc-200 mt-0.5\">\"{inv.setlistName}\"</p>\n                    <span className=\"text-[10px] text-zinc-500 dark:text-zinc-400 block mt-1\">\n                      Permiss\303\243o: {inv.role === \'edit\' ? \'Pode Editar\' : \'Somente Leitura\'}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-zinc-100 dark:border-purple-900/30\">\n                    <button\n                      onClick={() => handleRespondInv(inv, false)}\n                      className=\"flex items-center gap-1 px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 text-zinc-700 dark:text-zinc-300 font-semibold text-xs rounded-xl transition-colors\"\n                    >\n                      <X className=\"w-3.5 h-3.5\" />\n                      Recusar\n                    </button>\n                    <button\n                      onClick={() => handleRespondInv(inv, true)}\n                      className=\"flex items-center gap-1 px-4 py-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs rounded-xl shadow-md transition-colors\"\n                    >\n                      <Check className=\"w-3.5 h-3.5\" />\n                      Aceitar Setlist\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n\n        {/* Sent Invitations */}\n        {sentInvitations.length > 0 && (\n          <div className=\"space-y-2 pt-1\">\n            <h4 className=\"text-[11px] font-bold text-zinc-700 dark:text-purple-200\">\n              Convites Enviados por Voc\303\252 ({sentInvitations.length})\n            </h4>\n\n            <div className=\"space-y-2\">\n              {sentInvitations.map((inv) => (\n                <div\n                  key={inv.id}\n                  className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-3.5 flex items-center justify-between gap-2 shadow-sm text-xs\"\n                >\n                  <div className=\"min-w-0 flex-1\">\n                    <p className=\"font-bold text-zinc-900 dark:text-zinc-100 truncate\">{inv.invitedEmail}</p>\n                    <p className=\"text-[11px] text-zinc-500 dark:text-zinc-400 truncate\">Setlist: \"{inv.setlistName}\"</p>\n                    <div className=\"flex items-center gap-2 mt-1\">\n                      <span className=\"text-[10px] text-zinc-400 font-medium\">\n                        {inv.role === \'edit\' ? \'Pode Editar\' : \'Somente Leitura\'}\n                      </span>\n                      <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-md ${\n                        inv.status === \'accepted\'\n                          ? \'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20\'\n                          : inv.status === \'refused\'\n                          ? \'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20\'\n                          : \'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20\'\n                      }`}>\n                        {inv.status === \'accepted\' ? \'Aceito\' : inv.status === \'refused\' ? \'Recusado\' : \'Pendente\'}\n                      </span>\n                    </div>\n                  </div>\n\n                  {inv.status === \'pending\' && (\n                    <button\n                      onClick={() => handleRevokeInvite(inv)}\n                      className=\"p-2 text-zinc-400 hover:text-rose-500 hover:bg-rose-500/10 rounded-xl transition-colors shrink-0\"\n                      title=\"Cancelar convite\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Modal Create Invite */}\n      <Modal\n        isOpen={isCreateInviteOpen}\n        onClose={() => setIsCreateInviteOpen(false)}\n        title=\"Enviar Convite de Setlist\"\n      >\n        <form onSubmit={handleSendInviteSubmit} className=\"space-y-4\">\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Selecione o Setlist para Compartilhar *\n            </label>\n            <select\n              value={selectedSetlistId}\n              onChange={(e) => setSelectedSetlistId(e.target.value)}\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-purple-600 font-medium\"\n            >\n              {userSetlists.map((st) => (\n                <option key={st.id} value={st.id}>\n                  {st.name} ({st.blocks.length} blocos)\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              E-mail do M\303\272sico Convidado *\n            </label>\n            <input\n              type=\"email\"\n              required\n              placeholder=\"ex: musico@banda.com\"\n              value={inviteEmail}\n              onChange={(e) => setInviteEmail(e.target.value)}\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-purple-600\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              N\303\255vel de Permiss\303\243o\n            </label>\n            <div className=\"grid grid-cols-2 gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => setInviteRole(\'edit\')}\n                className={`py-2 px-3 text-xs font-bold rounded-xl border transition-all text-center ${\n                  inviteRole === \'edit\'\n                    ? \'bg-purple-600 text-white border-purple-600 shadow-sm\'\n                    : \'bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border-zinc-200 dark:border-purple-900/40\'\n                }`}\n              >\n                Pode Editar\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setInviteRole(\'view\')}\n                className={`py-2 px-3 text-xs font-bold rounded-xl border transition-all text-center ${\n                  inviteRole === \'view\'\n                    ? \'bg-purple-600 text-white border-purple-600 shadow-sm\'\n                    : \'bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border-zinc-200 dark:border-purple-900/40\'\n                }`}\n              >\n                Somente Leitura\n              </button>\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-zinc-100 dark:border-purple-900/30\">\n            <button\n              type=\"button\"\n              onClick={() => setIsCreateInviteOpen(false)}\n              className=\"px-4 py-2 text-xs font-semibold text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-xl transition-colors\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              disabled={isSubmittingInvite}\n              className=\"flex items-center gap-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-5 py-2 rounded-xl shadow-md transition-colors active:scale-95 disabled:opacity-50\"\n            >\n              <Send className=\"w-3.5 h-3.5\" />\n              <span>Enviar Convite</span>\n            </button>\n          </div>\n        </form>\n      </Modal>"
    }
