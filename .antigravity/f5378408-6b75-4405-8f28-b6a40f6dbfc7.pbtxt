        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    catalog[index] = updatedSong;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    localStorage.setItem(STORAGE_KEYS.CATALOG, JSON.stringify(catalog));"
