  file_change {
    absolute_path_uri: "file:///src/lib/supabase.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { createClient, SupabaseClient } from \'@supabase/supabase-js\';\nimport { SupabaseConfig, CatalogSong, Setlist } from \'../types\';\n\nconst SUPABASE_STORAGE_KEY = \'repertorio_supabase_config\';\n\nexport function getSupabaseConfig(): SupabaseConfig {\n  const envUrl = import.meta.env.VITE_SUPABASE_URL || \'\';\n  const envKey = import.meta.env.VITE_SUPABASE_ANON_KEY || \'\';\n\n  const raw = localStorage.getItem(SUPABASE_STORAGE_KEY);\n  if (raw) {\n    try {\n      const parsed = JSON.parse(raw);\n      return {\n        url: parsed.url || envUrl,\n        anonKey: parsed.anonKey || envKey,\n        isConnected: parsed.isConnected ?? false,\n        lastSyncedAt: parsed.lastSyncedAt\n      };\n    } catch {\n      // Fallback\n    }\n  }\n\n  return {\n    url: envUrl,\n    anonKey: envKey,\n    isConnected: !!(envUrl && envKey)\n  };\n}\n\nexport function saveSupabaseConfig(url: string, anonKey: string): SupabaseConfig {\n  const config: SupabaseConfig = {\n    url: url.trim(),\n    anonKey: anonKey.trim(),\n    isConnected: !!(url.trim() && anonKey.trim())\n  };\n  localStorage.setItem(SUPABASE_STORAGE_KEY, JSON.stringify(config));\n  return config;\n}\n\nlet supabaseClientInstance: SupabaseClient | null = null;\n\nexport function getSupabaseClient(): SupabaseClient | null {\n  const config = getSupabaseConfig();\n  if (!config.url || !config.anonKey) return null;\n\n  if (!supabaseClientInstance) {\n    try {\n      supabaseClientInstance = createClient(config.url, config.anonKey);\n    } catch (e) {\n      console.error(\'Failed to instantiate Supabase client:\', e);\n      return null;\n    }\n  }\n  return supabaseClientInstance;\n}\n\n// Reset instance when keys are changed\nexport function resetSupabaseClient() {\n  supabaseClientInstance = null;\n}\n\n// Test Connection\nexport async function testSupabaseConnection(url?: string, anonKey?: string): Promise<{ success: boolean; message: string }> {\n  const config = getSupabaseConfig();\n  const targetUrl = url !== undefined ? url.trim() : config.url;\n  const targetKey = anonKey !== undefined ? anonKey.trim() : config.anonKey;\n\n  if (!targetUrl || !targetKey) {\n    return { success: false, message: \'URL do Supabase e Chave An\303\264nima (anon key) s\303\243o obrigat\303\263rias.\' };\n  }\n\n  try {\n    const tempClient = createClient(targetUrl, targetKey);\n    // Simple light query\n    const { error } = await tempClient.from(\'songs\').select(\'count\', { count: \'exact\', head: true });\n\n    if (error && error.code !== \'PGRST116\' && !error.message.includes(\'relation \"public.songs\" does not exist\')) {\n      return { success: false, message: `Erro ao conectar: ${error.message}` };\n    }\n\n    // Save connection status\n    const saved = saveSupabaseConfig(targetUrl, targetKey);\n    saved.isConnected = true;\n    localStorage.setItem(SUPABASE_STORAGE_KEY, JSON.stringify(saved));\n    resetSupabaseClient();\n\n    return {\n      success: true,\n      message: error?.message.includes(\'relation \"public.songs\" does not exist\')\n        ? \'Conectado com sucesso ao Supabase! (Aviso: execute o script SQL disponibilizado para criar as tabelas no seu projeto).\'\n        : \'Conectado com sucesso ao banco de dados Supabase!\'\n    };\n  } catch (err: any) {\n    return { success: false, message: `Falha na conex\303\243o: ${err.message || \'Erro desconhecido\'}` };\n  }\n}\n\n// SQL Setup Script helper for user\nexport const SUPABASE_SQL_SCHEMA = `-- Copie e cole este script no SQL Editor do Supabase para criar a estrutura do Repert\303\263rio:\n\ncreate table if not exists public.songs (\n  id text primary key,\n  user_id text not null,\n  name text not null,\n  artist text not null,\n  original_key text not null,\n  slug_override text,\n  documents jsonb default \'[]\'::jsonb,\n  created_at timestamp with time zone default timezone(\'utc\'::text, now()) not null,\n  updated_at timestamp with time zone default timezone(\'utc\'::text, now()) not null\n);\n\ncreate table if not exists public.setlists (\n  id text primary key,\n  owner_id text not null,\n  owner_email text not null,\n  name text not null,\n  blocks jsonb default \'[]\'::jsonb,\n  members jsonb default \'[]\'::jsonb,\n  created_at timestamp with time zone default timezone(\'utc\'::text, now()) not null,\n  updated_at timestamp with time zone default timezone(\'utc\'::text, now()) not null\n);\n\n-- Habilitar Row Level Security (RLS) permissivo para anon/public no MVP\nalter table public.songs enable row level security;\nalter table public.setlists enable row level security;\n\ncreate policy \"Permitir tudo para anon\" on public.songs for all using (true) with check (true);\ncreate policy \"Permitir tudo para anon\" on public.setlists for all using (true) with check (true);\n`;\n\n// Sync Data to Supabase\nexport async function syncLocalDataToSupabase(songs: CatalogSong[], setlists: Setlist[]): Promise<{ success: boolean; message: string }> {\n  const client = getSupabaseClient();\n  if (!client) {\n    return { success: false, message: \'Supabase n\303\243o est\303\241 configurado. Insira a URL e Chave primeiro.\' };\n  }\n\n  try {\n    // 1. Sync Songs\n    if (songs.length > 0) {\n      const dbSongs = songs.map((s) => ({\n        id: s.id,\n        user_id: s.userId,\n        name: s.name,\n        artist: s.artist,\n        original_key: s.originalKey,\n        slug_override: s.slugOverride || null,\n        documents: s.documents || [],\n        updated_at: s.updatedAt || new Date().toISOString()\n      }));\n\n      const { error: songErr } = await client.from(\'songs\').upsert(dbSongs, { onConflict: \'id\' });\n      if (songErr) throw new Error(`Erro sincronizando m\303\272sicas: ${songErr.message}`);\n    }\n\n    // 2. Sync Setlists\n    if (setlists.length > 0) {\n      const dbSetlists = setlists.map((st) => ({\n        id: st.id,\n        owner_id: st.ownerId,\n        owner_email: st.ownerEmail,\n        name: st.name,\n        blocks: st.blocks,\n        members: st.members,\n        updated_at: st.updatedAt || new Date().toISOString()\n      }));\n\n      const { error: setlistErr } = await client.from(\'setlists\').upsert(dbSetlists, { onConflict: \'id\' });\n      if (setlistErr) throw new Error(`Erro sincronizando setlists: ${setlistErr.message}`);\n    }\n\n    // Update lastSyncedAt\n    const config = getSupabaseConfig();\n    config.lastSyncedAt = new Date().toISOString();\n    localStorage.setItem(SUPABASE_STORAGE_KEY, JSON.stringify(config));\n\n    return { success: true, message: \'Dados sincronizados com o Supabase com sucesso!\' };\n  } catch (err: any) {\n    return { success: false, message: err.message || \'Erro na sincroniza\303\247\303\243o com Supabase.\' };\n  }\n}\n\n// Fetch Remote Data from Supabase\nexport async function fetchRemoteDataFromSupabase(): Promise<{ songs: CatalogSong[]; setlists: Setlist[] } | null> {\n  const client = getSupabaseClient();\n  if (!client) return null;\n\n  try {\n    const { data: songsData, error: songsErr } = await client.from(\'songs\').select(\'*\');\n    const { data: setlistsData, error: setlistsErr } = await client.from(\'setlists\').select(\'*\');\n\n    if (songsErr || setlistsErr) {\n      console.warn(\'Could not fetch from Supabase:\', songsErr || setlistsErr);\n      return null;\n    }\n\n    const songs: CatalogSong[] = (songsData || []).map((row: any) => ({\n      id: row.id,\n      userId: row.user_id,\n      name: row.name,\n      artist: row.artist,\n      originalKey: row.original_key,\n      slugOverride: row.slug_override || undefined,\n      documents: row.documents || [],\n      createdAt: row.created_at,\n      updatedAt: row.updated_at\n    }));\n\n    const setlists: Setlist[] = (setlistsData || []).map((row: any) => ({\n      id: row.id,\n      ownerId: row.owner_id,\n      ownerEmail: row.owner_email,\n      name: row.name,\n      createdAt: row.created_at,\n      updatedAt: row.updated_at,\n      blocks: row.blocks || [],\n      members: row.members || []\n    }));\n\n    return { songs, setlists };\n  } catch (e) {\n    console.error(\'Fetch remote data error:\', e);\n    return null;\n  }\n}\n"
    }
