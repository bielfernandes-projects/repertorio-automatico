    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useAppStore } from \'../../lib/store\';\nimport { StorageEngine } from \'../../lib/storage\';\nimport { ArrowLeft, Music, Share2, Plus, Sparkles } from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenInviteModal?: () => void;\n  onOpenAddBlockModal?: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({ onOpenInviteModal, onOpenAddBlockModal }) => {\n  const {\n    activeTab,\n    activeSetlistId,\n    setActiveSetlistId,\n    focusedBlockId,\n    setFocusedBlockId\n  } = useAppStore();\n\n  const setlist = activeSetlistId ? StorageEngine.getSetlistById(activeSetlistId) : null;\n  const focusedBlock = setlist && focusedBlockId ? setlist.blocks.find((b) => b.id === focusedBlockId) : null;\n\n  // Header in focused block view\n  if (focusedBlock) {\n    return (\n      <header className=\"sticky top-0 z-30 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 flex items-center justify-between\">\n        <button\n          id=\"header-back-to-setlist\"\n          onClick={() => setFocusedBlockId(null)}\n          className=\"flex items-center gap-1.5 text-xs font-semibold text-emerald-400 bg-emerald-950/60 hover:bg-emerald-900/80 border border-emerald-800/50 px-3 py-1.5 rounded-full transition-colors active:scale-95\"\n        >\n          <ArrowLeft className=\"w-3.5 h-3.5\" />\n          <span>Voltar ao setlist</span>\n        </button>\n        <div className=\"text-right truncate max-w-[200px]\">\n          <span className=\"text-[10px] text-slate-400 uppercase tracking-wider font-medium block\">Bloco Focado</span>\n          <span className=\"text-sm font-bold text-slate-100 truncate block\">{focusedBlock.name}</span>\n        </div>\n      </header>\n    );\n  }\n\n  // Header in Setlist view\n  if (activeSetlistId && setlist) {\n    return (\n      <header className=\"sticky top-0 z-30 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 flex items-center justify-between\">\n        <div className=\"flex items-center gap-3 min-w-0\">\n          <button\n            id=\"header-back-to-setlists-list\"\n            onClick={() => setActiveSetlistId(null)}\n            className=\"p-1.5 text-slate-400 hover:text-slate-100 hover:bg-slate-800 rounded-lg transition-colors active:scale-95\"\n            title=\"Voltar aos Setlists\"\n          >\n            <ArrowLeft className=\"w-5 h-5\" />\n          </button>\n          <div className=\"min-w-0\">\n            <h1 className=\"text-base font-bold text-slate-100 truncate\">{setlist.name}</h1>\n            <span className=\"text-[11px] text-slate-400\">\n              {setlist.blocks.length} {setlist.blocks.length === 1 ? \'bloco\' : \'blocos\'}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          {onOpenInviteModal && (\n            <button\n              id=\"header-invite-btn\"\n              onClick={onOpenInviteModal}\n              className=\"p-2 text-slate-300 hover:text-emerald-400 hover:bg-slate-800/80 rounded-lg transition-colors active:scale-95 relative\"\n              title=\"Compartilhar / Convidados\"\n            >\n              <Share2 className=\"w-4 h-4\" />\n              {setlist.members.length > 0 && (\n                <span className=\"absolute -top-1 -right-1 bg-emerald-500 text-slate-950 text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center\">\n                  {setlist.members.length}\n                </span>\n              )}\n            </button>\n          )}\n\n          {onOpenAddBlockModal && (\n            <button\n              id=\"header-add-block-btn\"\n              onClick={onOpenAddBlockModal}\n              className=\"flex items-center gap-1 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold px-3 py-1.5 rounded-lg transition-transform active:scale-95 shadow-sm shadow-emerald-500/20\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span>Bloco</span>\n            </button>\n          )}\n        </div>\n      </header>\n    );\n  }\n\n  // Header for main tabs\n  return (\n    <header className=\"sticky top-0 z-30 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3.5 flex items-center justify-between\">\n      <div className=\"flex items-center gap-2.5\">\n        <div className=\"w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-slate-950 shadow-md shadow-emerald-500/20\">\n          <Music className=\"w-4 h-4 stroke-[2.5]\" />\n        </div>\n        <div>\n          <h1 className=\"text-base font-extrabold tracking-tight text-slate-100 flex items-center gap-1.5\">\n            Repert\303\263rio\n            <span className=\"text-emerald-400 text-xs font-semibold px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20\">\n              Auto\n            </span>\n          </h1>\n          <p className=\"text-[10px] text-slate-400 font-medium\">\n            {activeTab === \'setlists\' && \'Seus setlists de apresenta\303\247\303\265es\'}\n            {activeTab === \'catalog\' && \'Acervo geral de m\303\272sicas\'}\n            {activeTab === \'profile\' && \'Sua conta e convites\'}\n          </p>\n        </div>\n      </div>\n\n      <div className=\"flex items-center gap-1\">\n        <span className=\"inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-400/80 bg-emerald-950/40 border border-emerald-800/40 px-2 py-1 rounded-full\">\n          <Sparkles className=\"w-3 h-3 text-emerald-400\" />\n          PWA\n        </span>\n      </div>\n    </header>\n  );\n};\n"
    }
