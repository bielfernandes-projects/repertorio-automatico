  file_change {
    absolute_path_uri: "file:///src/components/common/Modal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect } from \'react\';\nimport { X } from \'lucide-react\';\n\ninterface ModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  title: string;\n  children: React.ReactNode;\n}\n\nexport const Modal: React.FC<ModalProps> = ({ isOpen, onClose, title, children }) => {\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') onClose();\n    };\n    if (isOpen) {\n      window.addEventListener(\'keydown\', handleKeyDown);\n      document.body.style.overflow = \'hidden\';\n    }\n    return () => {\n      window.removeEventListener(\'keydown\', handleKeyDown);\n      document.body.style.overflow = \'auto\';\n    };\n  }, [isOpen, onClose]);\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-950/80 backdrop-blur-sm animate-in fade-in duration-200\">\n      {/* Backdrop click */}\n      <div className=\"absolute inset-0\" onClick={onClose} />\n\n      {/* Bottom Sheet Card */}\n      <div className=\"relative w-full max-w-md bg-slate-900 border-t sm:border border-slate-800 rounded-t-3xl sm:rounded-2xl p-5 shadow-2xl z-10 max-h-[90vh] overflow-y-auto animate-in slide-in-from-bottom duration-300\">\n        {/* Handle pill for mobile touch feel */}\n        <div className=\"w-12 h-1.5 bg-slate-700 rounded-full mx-auto mb-4 sm:hidden\" />\n\n        {/* Modal Header */}\n        <div className=\"flex items-center justify-between pb-3 mb-4 border-b border-slate-800\">\n          <h2 className=\"text-base font-bold text-slate-100\">{title}</h2>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-slate-400 hover:text-slate-100 hover:bg-slate-800 rounded-lg transition-colors active:scale-95\"\n            aria-label=\"Fechar modal\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div>{children}</div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useEffect } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { X } from \'lucide-react\';"
