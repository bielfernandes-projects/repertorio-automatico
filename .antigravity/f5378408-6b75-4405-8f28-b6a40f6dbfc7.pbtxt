        }
        lines {
          text: "// Event listener type for simulated realtime updates"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "type RealtimeCallback = () => void;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "const subscribers = new Set<RealtimeCallback>();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function subscribeStorage(callback: RealtimeCallback) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  subscribers.add(callback);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return () => subscribers.delete(callback);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "function notifySubscribers() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  subscribers.forEach((cb) => cb());"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  window.dispatchEvent(new Event(\'repertorio_storage_updated\'));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
