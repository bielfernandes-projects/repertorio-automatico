    instruction: "Update handleCreate, handleDuplicate, and handleDeleteRequest in SetlistsList.tsx to sync with Supabase"
    replacement_infos {
      original_chunk {
        target_content: "  const handleCreate = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newSetName.trim()) return;\n\n    const created = StorageEngine.createSetlist(newSetName);\n    setIsCreateOpen(false);\n    setNewSetName(\'\');\n    reloadSetlists();\n    showToast(`Setlist \"${created.name}\" criado!`, \'success\');\n    setActiveSetlistId(created.id);\n  };\n\n  const handleDuplicate = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!duplicateTarget || !duplicateName.trim()) return;\n\n    const copy = StorageEngine.duplicateSetlist(duplicateTarget.id, duplicateName);\n    setDuplicateTarget(null);\n    setDuplicateName(\'\');\n    reloadSetlists();\n    if (copy) {\n      showToast(`Setlist duplicado como \"${copy.name}\"!`, \'success\');\n    }\n  };\n\n  const handleDeleteRequest = (setlist: Setlist, e: React.MouseEvent) => {\n    e.stopPropagation();\n    showCascadeWarning({\n      setlistId: setlist.id,\n      affectedBlocksCount: setlist.blocks.length,\n      affectedSetlistsCount: 1,\n      title: `Excluir Setlist \"${setlist.name}\"?`,\n      description: \'Esta a\303\247\303\243o excluir\303\241 o setlist e todos os seus blocos e refer\303\252ncias de m\303\272sicas. O acervo do cat\303\241logo n\303\243o ser\303\241 alterado.\',\n      onConfirm: () => {\n        StorageEngine.deleteSetlist(setlist.id);\n        reloadSetlists();\n        showToast(`Setlist \"${setlist.name}\" exclu\303\255do.`, \'info\');\n      }\n    });\n  };"
        replacement_content: "  const handleCreate = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newSetName.trim()) return;\n\n    const created = StorageEngine.createSetlist(newSetName);\n    setIsCreateOpen(false);\n    setNewSetName(\'\');\n    reloadSetlists();\n    showToast(`Setlist \"${created.name}\" criado!`, \'success\');\n    if (StorageEngine.getSupabaseConfig().isConnected) {\n      await syncLocalDataToSupabase();\n    }\n    setActiveSetlistId(created.id);\n  };\n\n  const handleDuplicate = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!duplicateTarget || !duplicateName.trim()) return;\n\n    const copy = StorageEngine.duplicateSetlist(duplicateTarget.id, duplicateName);\n    setDuplicateTarget(null);\n    setDuplicateName(\'\');\n    reloadSetlists();\n    if (copy) {\n      showToast(`Setlist duplicado como \"${copy.name}\"!`, \'success\');\n      if (StorageEngine.getSupabaseConfig().isConnected) {\n        await syncLocalDataToSupabase();\n      }\n    }\n  };\n\n  const handleDeleteRequest = (setlist: Setlist, e: React.MouseEvent) => {\n    e.stopPropagation();\n    showCascadeWarning({\n      setlistId: setlist.id,\n      affectedBlocksCount: setlist.blocks.length,\n      affectedSetlistsCount: 1,\n      title: `Excluir Setlist \"${setlist.name}\"?`,\n      description: \'Esta a\303\247\303\243o excluir\303\241 o setlist e todos os seus blocos e refer\303\252ncias de m\303\272sicas. O acervo do cat\303\241logo n\303\243o ser\303\241 alterado.\',\n      onConfirm: async () => {\n        StorageEngine.deleteSetlist(setlist.id);\n        reloadSetlists();\n        showToast(`Setlist \"${setlist.name}\" exclu\303\255do.`, \'info\');\n        if (StorageEngine.getSupabaseConfig().isConnected) {\n          await syncLocalDataToSupabase();\n        }\n      }\n    });\n  };"
      }
      num_matches: 1
    }
  }
}
