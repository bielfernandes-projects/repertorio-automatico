    instruction: "Update SetlistDetail theme styling to black, purple, white palette"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"p-4 space-y-4 pb-24 animate-in fade-in duration-200\">\n      {/* Setlist Title & Inline Rename */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          {isEditingName ? (\n            <div className=\"flex items-center gap-2 flex-1\">\n              <input\n                type=\"text\"\n                autoFocus\n                value={editSetName}\n                onChange={(e) => setEditSetName(e.target.value)}\n                onKeyDown={(e) => e.key === \'Enter\' && handleSaveSetlistName()}\n                className=\"flex-1 bg-slate-950 border border-emerald-500 rounded-xl px-3 py-1.5 text-sm font-bold text-slate-100 focus:outline-none\"\n              />\n              <button\n                onClick={handleSaveSetlistName}\n                className=\"p-2 bg-emerald-500 text-slate-950 font-bold rounded-xl active:scale-95 transition-transform\"\n              >\n                <Check className=\"w-4 h-4\" />\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex items-center gap-2 flex-1\">\n              <h2 className=\"text-base font-extrabold text-slate-100\">{setlist.name}</h2>\n              {isOwner && (\n                <button\n                  onClick={() => {\n                    setEditSetName(setlist.name);\n                    setIsEditingName(true);\n                  }}\n                  className=\"p-1 text-slate-400 hover:text-emerald-400 rounded-lg transition-colors\"\n                  title=\"Editar nome do setlist\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Search Bar inside setlist */}\n        <div className=\"relative\">\n          <Search className=\"w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Buscar por m\303\272sica, artista, bloco ou tema...\"\n            className=\"w-full bg-slate-950/80 border border-slate-800 focus:border-emerald-500 rounded-xl pl-9 pr-8 py-2 text-xs text-slate-100 placeholder-slate-500 focus:outline-none transition-colors\"\n          />\n          {searchQuery && (\n            <button\n              onClick={() => setSearchQuery(\'\')}\n              className=\"absolute right-2.5 top-1/2 -translate-y-1/2 p-0.5 text-slate-500 hover:text-slate-300\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Blocks List Section */}\n      <div className=\"space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5\">\n            <Layers className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Blocos ({filteredBlocks.length})\n          </h3>\n\n          <button\n            onClick={() => setIsAddBlockModalOpen(true)}\n            className=\"text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center gap-1 py-1 px-2 rounded-lg hover:bg-emerald-500/10 transition-colors\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Adicionar Bloco</span>\n          </button>\n        </div>\n\n        {filteredBlocks.length === 0 ? (\n          <div className=\"bg-slate-900/50 border border-slate-800 rounded-2xl p-6 text-center space-y-2\">\n            <p className=\"text-xs text-slate-400\">Nenhum bloco encontrado para esta busca.</p>\n          </div>\n        ) : (\n          <div className=\"space-y-2.5\">\n            {filteredBlocks.map((block, index) => {\n              const themeStyle = getThemeColorStyle(block.theme);\n              const catalog = StorageEngine.getCatalog();\n\n              return (\n                <div\n                  key={block.id}\n                  onClick={() => setFocusedBlockId(block.id)}\n                  className=\"group bg-slate-900/80 hover:bg-slate-800/90 border border-slate-800 hover:border-slate-700/80 rounded-2xl p-4 transition-all duration-200 cursor-pointer shadow-md active:scale-[0.99] space-y-2.5\"\n                >\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div className=\"space-y-1 min-w-0 flex-1\">\n                      <div className=\"flex items-center gap-2 flex-wrap\">\n                        <h4 className=\"text-sm font-bold text-slate-100 group-hover:text-emerald-400 transition-colors\">\n                          {block.name}\n                        </h4>\n                        {block.theme && (\n                          <span\n                            className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${themeStyle.bg} ${themeStyle.text} ${themeStyle.border}`}\n                          >\n                            {block.theme}\n                          </span>\n                        )}\n                      </div>\n                      <p className=\"text-[11px] text-slate-400\">\n                        {block.items.length} {block.items.length === 1 ? \'m\303\272sica\' : \'m\303\272sicas\'}\n                      </p>\n                    </div>\n\n                    <div className=\"flex items-center gap-1\" onClick={(e) => e.stopPropagation()}>\n                      {/* Reorder Buttons */}\n                      <button\n                        disabled={index === 0}\n                        onClick={(e) => handleMoveBlock(index, \'up\', e)}\n                        className=\"p-1.5 text-slate-500 hover:text-slate-200 disabled:opacity-30 rounded-lg hover:bg-slate-800\"\n                        title=\"Mover para cima\"\n                      >\n                        <ArrowUp className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        disabled={index === setlist.blocks.length - 1}\n                        onClick={(e) => handleMoveBlock(index, \'down\', e)}\n                        className=\"p-1.5 text-slate-500 hover:text-slate-200 disabled:opacity-30 rounded-lg hover:bg-slate-800\"\n                        title=\"Mover para baixo\"\n                      >\n                        <ArrowDown className=\"w-3.5 h-3.5\" />\n                      </button>\n\n                      {/* Edit Block */}\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          setEditingBlock(block);\n                          setBlockEditName(block.name);\n                          setBlockEditTheme(block.theme);\n                        }}\n                        className=\"p-1.5 text-slate-400 hover:text-amber-400 hover:bg-slate-800 rounded-lg transition-colors\"\n                        title=\"Editar Bloco\"\n                      >\n                        <Edit3 className=\"w-3.5 h-3.5\" />\n                      </button>\n\n                      {/* Delete Block */}\n                      <button\n                        onClick={(e) => handleDeleteBlockRequest(block, e)}\n                        className=\"p-1.5 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition-colors\"\n                        title=\"Excluir Bloco\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n\n                      <ChevronRight className=\"w-5 h-5 text-slate-600 group-hover:text-emerald-400 transition-colors ml-1\" />\n                    </div>\n                  </div>\n\n                  {/* Preview of songs inside block */}\n                  {block.items.length > 0 && (\n                    <div className=\"pt-2 border-t border-slate-800/60 space-y-1\">\n                      {block.items.slice(0, 3).map((item, songIdx) => {\n                        const song = catalog.find((s) => s.id === item.catalogSongId);\n                        if (!song) return null;\n                        return (\n                          <div\n                            key={item.id}\n                            className=\"text-xs text-slate-300 flex items-center justify-between font-mono\"\n                          >\n                            <span className=\"truncate\">\n                              <span className=\"text-slate-500 font-semibold mr-1.5\">\n                                {String(songIdx + 1).padStart(2, \'0\')}.\n                              </span>\n                              {song.name} \342\200\224 <span className=\"text-slate-400 font-sans\">{song.artist}</span>\n                            </span>\n                            <span className=\"text-[11px] font-bold text-slate-400 bg-slate-950 px-1.5 py-0.5 rounded ml-2\">\n                              {song.originalKey} {item.requestedKey && item.requestedKey !== song.originalKey ? `\342\206\222 ${item.requestedKey}` : \'\'}\n                            </span>\n                          </div>\n                        );\n                      })}\n                      {block.items.length > 3 && (\n                        <span className=\"text-[10px] text-slate-500 italic block pt-0.5\">\n                          + {block.items.length - 3} mais m\303\272sicas...\n                        </span>\n                      )}\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>"
        replacement_content: "  return (\n    <div className=\"p-4 space-y-4 pb-24 animate-in fade-in duration-200\">\n      {/* Setlist Title & Inline Rename */}\n      <div className=\"bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 shadow-md space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          {isEditingName ? (\n            <div className=\"flex items-center gap-2 flex-1\">\n              <input\n                type=\"text\"\n                autoFocus\n                value={editSetName}\n                onChange={(e) => setEditSetName(e.target.value)}\n                onKeyDown={(e) => e.key === \'Enter\' && handleSaveSetlistName()}\n                className=\"flex-1 bg-zinc-50 dark:bg-zinc-950 border border-purple-600 rounded-xl px-3 py-1.5 text-sm font-bold text-zinc-900 dark:text-zinc-100 focus:outline-none\"\n              />\n              <button\n                onClick={handleSaveSetlistName}\n                className=\"p-2 bg-purple-600 text-white font-bold rounded-xl active:scale-95 transition-transform\"\n              >\n                <Check className=\"w-4 h-4\" />\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex items-center gap-2 flex-1\">\n              <h2 className=\"text-base font-extrabold text-zinc-900 dark:text-zinc-100\">{setlist.name}</h2>\n              {isOwner && (\n                <button\n                  onClick={() => {\n                    setEditSetName(setlist.name);\n                    setIsEditingName(true);\n                  }}\n                  className=\"p-1 text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 rounded-lg transition-colors\"\n                  title=\"Editar nome do setlist\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Search Bar inside setlist */}\n        <div className=\"relative\">\n          <Search className=\"w-4 h-4 text-zinc-400 dark:text-purple-400/60 absolute left-3 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Buscar por m\303\272sica, artista, bloco ou tema...\"\n            className=\"w-full bg-zinc-50 dark:bg-zinc-950/80 border border-zinc-200 dark:border-purple-900/40 focus:border-purple-600 rounded-xl pl-9 pr-8 py-2 text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-purple-300/40 focus:outline-none transition-colors\"\n          />\n          {searchQuery && (\n            <button\n              onClick={() => setSearchQuery(\'\')}\n              className=\"absolute right-2.5 top-1/2 -translate-y-1/2 p-0.5 text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Blocks List Section */}\n      <div className=\"space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-xs font-bold text-zinc-500 dark:text-purple-300 uppercase tracking-wider flex items-center gap-1.5\">\n            <Layers className=\"w-3.5 h-3.5 text-purple-600 dark:text-purple-400\" />\n            Blocos ({filteredBlocks.length})\n          </h3>\n\n          <button\n            onClick={() => setIsAddBlockModalOpen(true)}\n            className=\"text-xs font-bold text-purple-600 dark:text-purple-400 hover:text-purple-500 flex items-center gap-1 py-1 px-2 rounded-lg hover:bg-purple-50 dark:hover:bg-purple-950/40 transition-colors\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Adicionar Bloco</span>\n          </button>\n        </div>\n\n        {filteredBlocks.length === 0 ? (\n          <div className=\"bg-white/50 dark:bg-[#120c24]/50 border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-6 text-center space-y-2\">\n            <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">Nenhum bloco encontrado para esta busca.</p>\n          </div>\n        ) : (\n          <div className=\"space-y-2.5\">\n            {filteredBlocks.map((block, index) => {\n              const themeStyle = getThemeColorStyle(block.theme);\n              const catalog = StorageEngine.getCatalog();\n\n              return (\n                <div\n                  key={block.id}\n                  onClick={() => setFocusedBlockId(block.id)}\n                  className=\"group bg-white dark:bg-[#120c24] hover:border-purple-400 dark:hover:border-purple-500/60 border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-4 transition-all duration-200 cursor-pointer shadow-sm dark:shadow-md active:scale-[0.99] space-y-2.5\"\n                >\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div className=\"space-y-1 min-w-0 flex-1\">\n                      <div className=\"flex items-center gap-2 flex-wrap\">\n                        <h4 className=\"text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors\">\n                          {block.name}\n                        </h4>\n                        {block.theme && (\n                          <span\n                            className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${themeStyle.bg} ${themeStyle.text} ${themeStyle.border}`}\n                          >\n                            {block.theme}\n                          </span>\n                        )}\n                      </div>\n                      <p className=\"text-[11px] text-zinc-500 dark:text-purple-300/70\">\n                        {block.items.length} {block.items.length === 1 ? \'m\303\272sica\' : \'m\303\272sicas\'}\n                      </p>\n                    </div>\n\n                    <div className=\"flex items-center gap-1\" onClick={(e) => e.stopPropagation()}>\n                      {/* Reorder Buttons */}\n                      <button\n                        disabled={index === 0}\n                        onClick={(e) => handleMoveBlock(index, \'up\', e)}\n                        className=\"p-1.5 text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200 disabled:opacity-30 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800\"\n                        title=\"Mover para cima\"\n                      >\n                        <ArrowUp className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        disabled={index === setlist.blocks.length - 1}\n                        onClick={(e) => handleMoveBlock(index, \'down\', e)}\n                        className=\"p-1.5 text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200 disabled:opacity-30 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800\"\n                        title=\"Mover para baixo\"\n                      >\n                        <ArrowDown className=\"w-3.5 h-3.5\" />\n                      </button>\n\n                      {/* Edit Block */}\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          setEditingBlock(block);\n                          setBlockEditName(block.name);\n                          setBlockEditTheme(block.theme);\n                        }}\n                        className=\"p-1.5 text-zinc-400 hover:text-amber-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors\"\n                        title=\"Editar Bloco\"\n                      >\n                        <Edit3 className=\"w-3.5 h-3.5\" />\n                      </button>\n\n                      {/* Delete Block */}\n                      <button\n                        onClick={(e) => handleDeleteBlockRequest(block, e)}\n                        className=\"p-1.5 text-zinc-400 hover:text-rose-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors\"\n                        title=\"Excluir Bloco\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n\n                      <ChevronRight className=\"w-5 h-5 text-zinc-400 dark:text-purple-400/60 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors ml-1\" />\n                    </div>\n                  </div>\n\n                  {/* Preview of songs inside block */}\n                  {block.items.length > 0 && (\n                    <div className=\"pt-2 border-t border-zinc-100 dark:border-purple-900/30 space-y-1\">\n                      {block.items.slice(0, 3).map((item, songIdx) => {\n                        const song = catalog.find((s) => s.id === item.catalogSongId);\n                        if (!song) return null;\n                        return (\n                          <div\n                            key={item.id}\n                            className=\"text-xs text-zinc-700 dark:text-zinc-300 flex items-center justify-between font-mono\"\n                          >\n                            <span className=\"truncate\">\n                              <span className=\"text-purple-600 dark:text-purple-400 font-semibold mr-1.5\">\n                                {String(songIdx + 1).padStart(2, \'0\')}.\n                              </span>\n                              {song.name} \342\200\224 <span className=\"text-zinc-500 dark:text-zinc-400 font-sans\">{song.artist}</span>\n                            </span>\n                            <span className=\"text-[11px] font-bold text-zinc-600 dark:text-purple-300 bg-zinc-100 dark:bg-zinc-950 px-1.5 py-0.5 rounded ml-2\">\n                              {song.originalKey} {item.requestedKey && item.requestedKey !== song.originalKey ? `\342\206\222 ${item.requestedKey}` : \'\'}\n                            </span>\n                          </div>\n                        );\n                      })}\n                      {block.items.length > 3 && (\n                        <span className=\"text-[10px] text-zinc-400 dark:text-zinc-500 italic block pt-0.5\">\n                          + {block.items.length - 3} mais m\303\272sicas...\n                        </span>\n                      )}\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>"
