        }
        lines {
          text: "  static saveCatalog(catalog: CatalogSong[]) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    localStorage.setItem(STORAGE_KEYS.CATALOG, JSON.stringify(catalog));"
