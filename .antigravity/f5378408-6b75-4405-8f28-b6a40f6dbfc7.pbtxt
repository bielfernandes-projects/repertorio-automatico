  file_change {
    absolute_path_uri: "file:///src/components/catalog/CatalogView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { useAppStore } from \'../../lib/store\';\nimport { StorageEngine } from \'../../lib/storage\';\nimport { CatalogSong } from \'../../types\';\nimport { Modal } from \'../common/Modal\';\nimport { SongDocumentsModal } from \'../common/SongDocumentsModal\';\nimport { Search, Plus, Music, Edit3, Trash2, Globe, FileMusic, X, Paperclip } from \'lucide-react\';\nimport { buildCifraClubUrl } from \'../../lib/utils\';\n\nexport const CatalogView: React.FC = () => {\n  const { showToast, showCascadeWarning, openCifraModal } = useAppStore();\n  const [catalog, setCatalog] = useState<CatalogSong[]>(() => StorageEngine.getCatalog());\n  const [search, setSearch] = useState(\'\');\n\n  // Documents Modal State\n  const [docsModalSong, setDocsModalSong] = useState<CatalogSong | null>(null);\n\n  // Subscribe to storage\n  useEffect(() => {\n    const unsubscribe = StorageEngine.subscribeStorage(() => {\n      setCatalog(StorageEngine.getCatalog());\n    });\n    return unsubscribe;\n  }, []);\n\n  // Modal create\n  const [isCreateOpen, setIsCreateOpen] = useState(false);\n  const [name, setName] = useState(\'\');\n  const [artist, setArtist] = useState(\'\');\n  const [key, setKey] = useState(\'\');\n  const [slug, setSlug] = useState(\'\');\n\n  // Modal edit\n  const [editingSong, setEditingSong] = useState<CatalogSong | null>(null);\n  const [editName, setEditName] = useState(\'\');\n  const [editArtist, setEditArtist] = useState(\'\');\n  const [editKey, setEditKey] = useState(\'\');\n  const [editSlug, setEditSlug] = useState(\'\');\n\n  const handleCreateSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim() || !artist.trim()) {\n      showToast(\'Nome e Artista s\303\243o obrigat\303\263rios.\', \'error\');\n      return;\n    }\n\n    const created = StorageEngine.addCatalogSong(name, artist, key || \'C\', slug);\n    setIsCreateOpen(false);\n    setName(\'\');\n    setArtist(\'\');\n    setKey(\'\');\n    setSlug(\'\');\n    showToast(`M\303\272sica \"${created.name}\" adicionada ao cat\303\241logo!`, \'success\');\n  };\n\n  const handleEditSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!editingSong || !editName.trim() || !editArtist.trim()) {\n      showToast(\'Nome e Artista s\303\243o obrigat\303\263rios.\', \'error\');\n      return;\n    }\n\n    StorageEngine.updateCatalogSong(editingSong.id, {\n      name: editName,\n      artist: editArtist,\n      originalKey: editKey,\n      slugOverride: editSlug\n    });\n\n    setEditingSong(null);\n    showToast(`M\303\272sica \"${editName}\" atualizada!`, \'success\');\n  };\n\n  const handleDeleteRequest = (song: CatalogSong) => {\n    const impact = StorageEngine.checkDeleteSongCascade(song.id);\n\n    showCascadeWarning({\n      songId: song.id,\n      affectedBlocksCount: impact.affectedBlocksCount,\n      affectedSetlistsCount: impact.affectedSetlistsCount,\n      title: `Excluir \"${song.name}\" do Cat\303\241logo?`,\n      description: \'Esta m\303\272sica ser\303\241 removida do seu acervo permanente e de todas as refer\303\252ncias em todos os blocos de setlists.\',\n      onConfirm: () => {\n        StorageEngine.deleteCatalogSong(song.id);\n        showToast(`M\303\272sica \"${song.name}\" exclu\303\255da.`, \'info\');\n      }\n    });\n  };\n\n  const handleOpenCifra = (song: CatalogSong) => {\n    const { url } = buildCifraClubUrl(\n      song.artist,\n      song.name,\n      song.originalKey,\n      undefined,\n      song.slugOverride\n    );\n    openCifraModal(song.name, song.artist, url, song.originalKey, undefined, song.slugOverride, song.id);\n  };\n\n  // Filter Search\n  const filteredCatalog = catalog.filter((song) => {\n    if (!search.trim()) return true;\n    const q = search.toLowerCase();\n    return song.name.toLowerCase().includes(q) || song.artist.toLowerCase().includes(q);\n  });\n\n  return (\n    <div className=\"p-4 space-y-4 pb-24 animate-in fade-in duration-200\">\n      {/* Top action row */}\n      <div className=\"flex items-center justify-between\">\n        <h2 className=\"text-xs font-bold text-zinc-400 dark:text-purple-300 uppercase tracking-wider flex items-center gap-2\">\n          <Music className=\"w-4 h-4 text-purple-600 dark:text-purple-400\" />\n          Seu Cat\303\241logo ({catalog.length})\n        </h2>\n\n        <button\n          id=\"create-catalog-song-btn\"\n          onClick={() => setIsCreateOpen(true)}\n          className=\"flex items-center gap-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl shadow-lg shadow-purple-900/30 active:scale-95 transition-transform\"\n        >\n          <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n          <span>Nova M\303\272sica</span>\n        </button>\n      </div>\n\n      {/* Search Input */}\n      <div className=\"relative\">\n        <Search className=\"w-4 h-4 text-zinc-400 dark:text-purple-400/60 absolute left-3 top-1/2 -translate-y-1/2\" />\n        <input\n          type=\"text\"\n          value={search}\n          onChange={(e) => setSearch(e.target.value)}\n          placeholder=\"Buscar por nome da m\303\272sica ou artista...\"\n          className=\"w-full bg-white dark:bg-[#120c24] border border-zinc-200 dark:border-purple-900/40 focus:border-purple-600 dark:focus:border-purple-500 rounded-xl pl-9 pr-8 py-2.5 text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-purple-300/40 focus:outline-none transition-colors\"\n        />\n        {search && (\n          <button\n            onClick={() => setSearch(\'\')}\n            className=\"absolute right-2.5 top-1/2 -translate-y-1/2 p-0.5 text-zinc-400 hover:text-zinc-200\"\n          >\n            <X className=\"w-3.5 h-3.5\" />\n          </button>\n        )}\n      </div>\n\n      {/* List of catalog songs */}\n      {filteredCatalog.length === 0 ? (\n        <div className=\"bg-white/80 dark:bg-[#120c24]/80 border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-8 text-center space-y-3\">\n          <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">Nenhuma m\303\272sica encontrada no seu cat\303\241logo.</p>\n          <button\n            onClick={() => setIsCreateOpen(true)}\n            className=\"bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-4 py-2 rounded-xl inline-flex items-center gap-1.5 shadow-md\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Adicionar M\303\272sica ao Cat\303\241logo</span>\n          </button>\n        </div>\n      ) : (\n        <div className=\"space-y-2\">\n          {filteredCatalog.map((song) => {\n            const docCount = song.documents?.length || 0;\n\n            return (\n              <div\n                key={song.id}\n                className=\"bg-white dark:bg-[#120c24] hover:border-purple-400 dark:hover:border-purple-500/60 border border-zinc-200 dark:border-purple-900/40 rounded-2xl p-3.5 transition-all duration-200 flex items-center justify-between gap-3 shadow-sm dark:shadow-md\"\n              >\n                <div className=\"min-w-0 flex-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <h3 className=\"text-sm font-bold text-zinc-900 dark:text-zinc-100 truncate\">{song.name}</h3>\n                    {docCount > 0 && (\n                      <span className=\"text-[10px] font-bold text-purple-600 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800/60 px-1.5 py-0.2 rounded-md flex items-center gap-0.5\">\n                        <Paperclip className=\"w-2.5 h-2.5\" />\n                        {docCount}\n                      </span>\n                    )}\n                  </div>\n                  <p className=\"text-xs text-zinc-500 dark:text-purple-300/70 truncate\">{song.artist}</p>\n                </div>\n\n                <div className=\"flex items-center gap-1.5 shrink-0\">\n                  <span\n                    className=\"font-mono text-xs font-bold text-purple-600 dark:text-purple-300 bg-purple-50 dark:bg-zinc-950 border border-purple-200 dark:border-purple-900/60 px-2.5 py-1 rounded-xl shadow-inner\"\n                    title=\"Tom Original\"\n                  >\n                    {song.originalKey}\n                  </span>\n\n                  {/* Open Partituras / Documents button */}\n                  <button\n                    onClick={() => setDocsModalSong(song)}\n                    className=\"p-2 text-zinc-600 dark:text-purple-300 hover:text-purple-600 dark:hover:text-white hover:bg-purple-50 dark:hover:bg-purple-950/60 rounded-xl transition-colors relative\"\n                    title={`Ver Partituras / Anexos (${docCount}/5)`}\n                  >\n                    <FileMusic className=\"w-4 h-4\" />\n                    {docCount > 0 && (\n                      <span className=\"absolute -top-1 -right-1 bg-purple-600 text-white text-[9px] font-extrabold w-3.5 h-3.5 rounded-full flex items-center justify-center\">\n                        {docCount}\n                      </span>\n                    )}\n                  </button>\n\n                  {/* Open Cifra Club button */}\n                  <button\n                    onClick={() => handleOpenCifra(song)}\n                    className=\"p-2 text-zinc-600 dark:text-purple-300 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-zinc-800 rounded-xl transition-colors\"\n                    title=\"Abrir Cifra Club\"\n                  >\n                    <Globe className=\"w-4 h-4 text-purple-500 dark:text-purple-400\" />\n                  </button>\n\n                  {/* Edit song */}\n                  <button\n                    onClick={() => {\n                      setEditingSong(song);\n                      setEditName(song.name);\n                      setEditArtist(song.artist);\n                      setEditKey(song.originalKey);\n                      setEditSlug(song.slugOverride || \'\');\n                    }}\n                    className=\"p-2 text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-xl transition-colors\"\n                    title=\"Editar m\303\272sica\"\n                  >\n                    <Edit3 className=\"w-4 h-4\" />\n                  </button>\n\n                  {/* Delete song */}\n                  <button\n                    onClick={() => handleDeleteRequest(song)}\n                    className=\"p-2 text-zinc-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-zinc-800 rounded-xl transition-colors\"\n                    title=\"Excluir m\303\272sica\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Modal Create Song */}\n      <Modal isOpen={isCreateOpen} onClose={() => setIsCreateOpen(false)} title=\"Nova M\303\272sica no Cat\303\241logo\">\n        <form onSubmit={handleCreateSubmit} className=\"space-y-4\">\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Nome da M\303\272sica *\n            </label>\n            <input\n              type=\"text\"\n              required\n              autoFocus\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              placeholder=\"ex: Evid\303\252ncias\"\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-purple-600\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Artista / Banda * (Obrigat\303\263rio para achar cifra)\n            </label>\n            <input\n              type=\"text\"\n              required\n              value={artist}\n              onChange={(e) => setArtist(e.target.value)}\n              placeholder=\"ex: Chit\303\243ozinho & Xoror\303\263\"\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-purple-600\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Tom Original (Livre texto)\n            </label>\n            <input\n              type=\"text\"\n              value={key}\n              onChange={(e) => setKey(e.target.value)}\n              placeholder=\"ex: E, Am, Sol Maior, D\303\263\"\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-purple-600\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Slug Cifra Club Opcional (URL)\n            </label>\n            <input\n              type=\"text\"\n              value={slug}\n              onChange={(e) => setSlug(e.target.value)}\n              placeholder=\"ex: evidencias (opcional)\"\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-purple-600 font-mono text-xs\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-end gap-2 pt-2\">\n            <button\n              type=\"button\"\n              onClick={() => setIsCreateOpen(false)}\n              className=\"px-4 py-2 text-xs font-semibold text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-lg shadow-purple-900/20\"\n            >\n              Salvar no Cat\303\241logo\n            </button>\n          </div>\n        </form>\n      </Modal>\n\n      {/* Modal Edit Song */}\n      <Modal isOpen={!!editingSong} onClose={() => setEditingSong(null)} title=\"Editar M\303\272sica do Cat\303\241logo\">\n        <form onSubmit={handleEditSubmit} className=\"space-y-4\">\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Nome da M\303\272sica *\n            </label>\n            <input\n              type=\"text\"\n              required\n              value={editName}\n              onChange={(e) => setEditName(e.target.value)}\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-purple-600\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Artista / Banda *\n            </label>\n            <input\n              type=\"text\"\n              required\n              value={editArtist}\n              onChange={(e) => setEditArtist(e.target.value)}\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-purple-600\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Tom Original\n            </label>\n            <input\n              type=\"text\"\n              value={editKey}\n              onChange={(e) => setEditKey(e.target.value)}\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-purple-600\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n              Slug Cifra Club Personalizado\n            </label>\n            <input\n              type=\"text\"\n              value={editSlug}\n              onChange={(e) => setEditSlug(e.target.value)}\n              className=\"w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-purple-900/60 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-purple-600 font-mono text-xs\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-end gap-2 pt-2\">\n            <button\n              type=\"button\"\n              onClick={() => setEditingSong(null)}\n              className=\"px-4 py-2 text-xs font-semibold text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-lg shadow-purple-900/20\"\n            >\n              Salvar Altera\303\247\303\265es\n            </button>\n          </div>\n        </form>\n      </Modal>\n\n      {/* Modal Documents / Partituras */}\n      <SongDocumentsModal\n        song={docsModalSong}\n        isOpen={!!docsModalSong}\n        onClose={() => setDocsModalSong(null)}\n        onSongUpdated={(updated) => {\n          setDocsModalSong(updated);\n          setCatalog(StorageEngine.getCatalog());\n        }}\n      />\n    </div>\n  );\n};\n"
    }
