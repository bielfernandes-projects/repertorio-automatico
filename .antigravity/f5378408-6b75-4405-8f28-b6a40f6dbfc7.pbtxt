        }
        lines {
          text: "      // Sort alphabetically by name"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      return items.sort((a, b) => a.name.localeCompare(b.name, \'pt-BR\'));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    } catch {"
