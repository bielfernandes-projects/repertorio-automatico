        lines {
          text: " * Converts arbitrary string IDs to a valid RFC-4122 UUID v4 string deterministically"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: " * so Postgres uuid columns accept local IDs (e.g., \'song_01\', \'set_01\') seamlessly."
