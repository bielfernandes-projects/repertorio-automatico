          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  static getCatalogSongById(id: string): CatalogSong | undefined {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return this.getCatalog().find((s) => s.id === id);"
