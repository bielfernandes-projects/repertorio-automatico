ld-500/10 shadow-inner\'\n              : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n          }`}\n        >\n          <Music className=\"w-6 h-6 stroke-[2]\" />\n          {activeTab === \'catalog\' && (\n            <span className=\"absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-emerald-400 rounded-full\" />\n          )}\n        </button>\n\n        <button\n          id=\"nav-tab-profile\"\n          onClick={() => handleTabClick(\'profile\')}\n          aria-label=\"Perfil\"\n          className={`relative p-3 rounded-2xl transition-all duration-200 active:scale-90 ${\n            activeTab === \'profile\'\n              ? \'text-emerald-400 bg-emerald-500/10 shadow-inner\'\n              : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n          }`}\n        >\n          <User className=\"w-6 h-6 stroke-[2]\" />\n          {activeTab === \'profile\' && (\n            <span className=\"absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-emerald-400 rounded-full\" />\n          )}\n        </button>\n      </div>\n    </nav>\n  );\n};\n"
