    replacement_chunks {
      target_content: "export const CifraWebviewModal: React.FC = () => {\n  const { cifraModal, closeCifraModal, showToast } = useAppStore();\n  const [isEditingSlug, setIsEditingSlug] = useState(false);\n  const [customSlug, setCustomSlug] = useState(\'\');\n  const [iframeError, setIframeError] = useState(false);\n\n  if (!cifraModal || !cifraModal.isOpen) return null;\n\n  const { songName, artist, url, originalKey, requestedKey, songId, slugOverride } = cifraModal;\n\n  const handleSaveSlug = () => {\n    if (songId) {\n      StorageEngine.updateCatalogSong(songId, { slugOverride: customSlug.trim() });\n      showToast(\'Link da cifra atualizado no cat\303\241logo!\', \'success\');\n      setIsEditingSlug(false);\n      closeCifraModal();\n    }\n  };\n\n  const openExternalBrowser = () => {\n    window.open(url, \'_blank\', \'noopener,noreferrer\');\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex flex-col bg-slate-950/95 backdrop-blur-md animate-in fade-in duration-200\">\n      {/* Top Controls Bar */}\n      <div className=\"bg-slate-900 border-b border-slate-800 px-4 py-3 flex items-center justify-between gap-3 shadow-md\">\n        <div className=\"min-w-0\">\n          <div className=\"flex items-center gap-2\">\n            <h2 className=\"text-sm font-bold text-slate-100 truncate\">{songName}</h2>\n            {requestedKey && (\n              <span className=\"text-[10px] font-bold text-emerald-400 bg-emerald-950 border border-emerald-800 px-2 py-0.5 rounded-md\">\n                Tom: {requestedKey}\n              </span>\n            )}\n          </div>\n          <p className=\"text-xs text-slate-400 truncate\">{artist} \342\200\242 Cifra Club</p>\n        </div>\n\n        <div className=\"flex items-center gap-1.5 shrink-0\">\n          <button\n            onClick={() => {\n              setCustomSlug(slugOverride || \'\');\n              setIsEditingSlug(!isEditingSlug);\n            }}\n            className=\"p-2 text-slate-300 hover:text-amber-400 hover:bg-slate-800 rounded-xl transition-colors\"\n            title=\"Ajustar slug do link\"\n          >\n            <Edit3 className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={openExternalBrowser}\n            className=\"flex items-center gap-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold px-2.5 py-1.5 rounded-xl border border-slate-700 transition-colors\"\n            title=\"Abrir no navegador do sistema\"\n          >\n            <ExternalLink className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">Navegador</span>\n          </button>\n\n          <button\n            onClick={closeCifraModal}\n            className=\"p-2 text-slate-300 hover:text-white bg-slate-800 hover:bg-rose-950/80 hover:text-rose-400 rounded-xl transition-colors ml-1\"\n            aria-label=\"Fechar cifra\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Adjust Slug Row if triggered */}\n      {isEditingSlug && (\n        <div className=\"bg-slate-900/90 border-b border-slate-800 px-4 py-2.5 flex items-center gap-2 animate-in slide-in-from-top duration-200\">\n          <span className=\"text-xs text-slate-400 whitespace-nowrap\">Slug da cifra:</span>\n          <input\n            type=\"text\"\n            value={customSlug}\n            onChange={(e) => setCustomSlug(e.target.value)}\n            placeholder=\"ex: eduardo-e-monica\"\n            className=\"flex-1 bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-slate-100 focus:outline-none focus:border-emerald-500\"\n          />\n          <button\n            onClick={handleSaveSlug}\n            className=\"bg-emerald-500 text-slate-950 font-bold px-3 py-1 rounded-lg text-xs flex items-center gap-1 hover:bg-emerald-400\"\n          >\n            <Check className=\"w-3.5 h-3.5\" />\n            Salvar\n          </button>\n        </div>\n      )}\n\n      {/* URL Banner */}\n      <div className=\"bg-slate-950/80 px-4 py-1.5 border-b border-slate-800/80 text-[11px] text-slate-400 font-mono truncate flex items-center gap-2\">\n        <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0\" />\n        <span className=\"truncate\">{url}</span>\n      </div>\n\n      {/* Webview iframe Container */}\n      <div className=\"flex-1 relative bg-slate-950\">\n        {iframeError ? (\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center\">\n            <div className=\"w-12 h-12 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center mb-3\">\n              <AlertCircle className=\"w-6 h-6\" />\n            </div>\n            <h3 className=\"text-sm font-bold text-slate-200 mb-1\">Cifra n\303\243o p\303\264de ser embutida diretamente</h3>\n            <p className=\"text-xs text-slate-400 max-w-xs mb-4\">\n              O site Cifra Club restringe a visualiza\303\247\303\243o em iFrames de alguns navegadores mobile.\n            </p>\n            <button\n              onClick={openExternalBrowser}\n              className=\"bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2\"\n            >\n              <ExternalLink className=\"w-4 h-4\" />\n              <span>Abrir Cifra no Navegador Externo</span>\n            </button>\n          </div>\n        ) : (\n          <iframe\n            src={url}\n            title={`Cifra - ${songName}`}\n            onError={() => setIframeError(true)}\n            className=\"w-full h-full border-0 bg-white\"\n            sandbox=\"allow-same-origin allow-scripts allow-popups allow-forms\"\n          />\n        )}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "export const CifraWebviewModal: React.FC = () => {\n  const { cifraModal, closeCifraModal, showToast } = useAppStore();\n  const [isEditingSlug, setIsEditingSlug] = useState(false);\n  const [customSlug, setCustomSlug] = useState(\'\');\n  const [iframeError, setIframeError] = useState(false);\n\n  if (!cifraModal || !cifraModal.isOpen) return null;\n\n  const { songName, artist, url, originalKey, requestedKey, songId, slugOverride } = cifraModal;\n\n  const handleSaveSlug = () => {\n    if (songId) {\n      StorageEngine.updateCatalogSong(songId, { slugOverride: customSlug.trim() });\n      showToast(\'Link da cifra atualizado no cat\303\241logo!\', \'success\');\n      setIsEditingSlug(false);\n      closeCifraModal();\n    }\n  };\n\n  const openExternalBrowser = () => {\n    window.open(url, \'_blank\', \'noopener,noreferrer\');\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex flex-col bg-zinc-950/95 dark:bg-[#090714]/95 backdrop-blur-md animate-in fade-in duration-200\">\n      {/* Top Controls Bar */}\n      <div className=\"bg-zinc-900 dark:bg-[#120c24] border-b border-purple-900/40 px-4 py-3 flex items-center justify-between gap-3 shadow-md\">\n        <div className=\"min-w-0\">\n          <div className=\"flex items-center gap-2\">\n            <h2 className=\"text-sm font-bold text-zinc-100 truncate\">{songName}</h2>\n            {requestedKey && (\n              <span className=\"text-[10px] font-bold text-purple-300 bg-purple-950/60 border border-purple-700/50 px-2 py-0.5 rounded-md\">\n                Tom: {requestedKey}\n              </span>\n            )}\n          </div>\n          <p className=\"text-xs text-purple-300/80 truncate\">{artist} \342\200\242 Cifra Club</p>\n        </div>\n\n        <div className=\"flex items-center gap-1.5 shrink-0\">\n          <button\n            onClick={() => {\n              setCustomSlug(slugOverride || \'\');\n              setIsEditingSlug(!isEditingSlug);\n            }}\n            className=\"p-2 text-zinc-300 hover:text-amber-400 hover:bg-zinc-800 rounded-xl transition-colors\"\n            title=\"Ajustar slug do link\"\n          >\n            <Edit3 className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={openExternalBrowser}\n            className=\"flex items-center gap-1 bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold px-2.5 py-1.5 rounded-xl border border-purple-500/30 transition-colors\"\n            title=\"Abrir no navegador do sistema\"\n          >\n            <ExternalLink className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">Navegador</span>\n          </button>\n\n          <button\n            onClick={closeCifraModal}\n            className=\"p-2 text-zinc-300 hover:text-white bg-zinc-800 hover:bg-rose-950/80 hover:text-rose-400 rounded-xl transition-colors ml-1\"\n            aria-label=\"Fechar cifra\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Adjust Slug Row if triggered */}\n      {isEditingSlug && (\n        <div className=\"bg-zinc-900/90 dark:bg-[#120c24]/90 border-b border-purple-900/40 px-4 py-2.5 flex items-center gap-2 animate-in slide-in-from-top duration-200\">\n          <span className=\"text-xs text-zinc-400 whitespace-nowrap\">Slug da cifra:</span>\n          <input\n            type=\"text\"\n            value={customSlug}\n            onChange={(e) => setCustomSlug(e.target.value)}\n            placeholder=\"ex: eduardo-e-monica\"\n            className=\"flex-1 bg-zinc-950 border border-purple-800 rounded-lg px-2.5 py-1 text-xs text-zinc-100 focus:outline-none focus:border-purple-500\"\n          />\n          <button\n            onClick={handleSaveSlug}\n            className=\"bg-purple-600 text-white font-bold px-3 py-1 rounded-lg text-xs flex items-center gap-1 hover:bg-purple-500\"\n          >\n            <Check className=\"w-3.5 h-3.5\" />\n            Salvar\n          </button>\n        </div>\n      )}\n\n      {/* URL Banner */}\n      <div className=\"bg-zinc-950/80 px-4 py-1.5 border-b border-purple-900/30 text-[11px] text-purple-300/80 font-mono truncate flex items-center gap-2\">\n        <span className=\"w-2 h-2 rounded-full bg-purple-400 animate-pulse shrink-0\" />\n        <span className=\"truncate\">{url}</span>\n      </div>\n\n      {/* Webview iframe Container */}\n      <div className=\"flex-1 relative bg-zinc-950\">\n        {iframeError ? (\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center\">\n            <div className=\"w-12 h-12 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center mb-3\">\n              <AlertCircle className=\"w-6 h-6\" />\n            </div>\n            <h3 className=\"text-sm font-bold text-zinc-200 mb-1\">Cifra n\303\243o p\303\264de ser embutida diretamente</h3>\n            <p className=\"text-xs text-zinc-400 max-w-xs mb-4\">\n              O site Cifra Club restringe a visualiza\303\247\303\243o em iFrames de alguns navegadores mobile.\n            </p>\n            <button\n              onClick={openExternalBrowser}\n              className=\"bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2\"\n            >\n              <ExternalLink className=\"w-4 h-4\" />\n              <span>Abrir Cifra no Navegador Externo</span>\n            </button>\n          </div>\n        ) : (\n          <iframe\n            src={url}\n            title={`Cifra - ${songName}`}\n            onError={() => setIframeError(true)}\n            className=\"w-full h-full border-0 bg-white\"\n            sandbox=\"allow-same-origin allow-scripts allow-popups allow-forms\"\n          />\n        )}\n      </div>\n    </div>\n  );\n};"
